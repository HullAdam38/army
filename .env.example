# Required in production: long random string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3000
# Optional: path to the SQLite database file (default: data/eliteforces.db)
# DB_FILE=./data/eliteforces.db
# Reverse proxy trust. In production the default trusts a proxy on the same machine
# ('loopback'), which is right for nginx/Caddy on the same server. If the proxy is on
# another machine set its hop count (1) or IP/subnet. Set to 'false' to disable.
# TRUST_PROXY=loopback
