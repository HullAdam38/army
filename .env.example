# Required in production: long random string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3000
# Optional: path to the SQLite database file (default: data/eliteforces.db)
# DB_FILE=./data/eliteforces.db
# Set to 1 when running behind a reverse proxy / load balancer (for secure cookies & client IPs)
# TRUST_PROXY=1
