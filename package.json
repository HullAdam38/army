  },
  "homepage": "https://github.com/HullAdam38/army#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "web-push": "^3.6.7"
  },
  "private": true,
