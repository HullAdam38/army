<%- include('../partials/head', { bodyClass: 'page-game page-admin' }) %>
<%- include('../partials/header') %>

<main id="main" class="container game-main">
  <a class="back-link" href="/admin"><svg aria-hidden="true"><use href="#i-arrow"/></svg>Admin</a>
  <div class="page-head">
    <div>
      <p class="eyebrow">Moderation</p>
      <h1 class="page-head__title">Reported messages</h1>
      <p class="page-head__sub">Private messages players have reported. You only ever see a message once someone reports it. This is a copy taken at the time of the report. To warn or suspend the sender, open their admin page.</p>
    </div>
  </div>

  <nav class="tabs flag-tabs" aria-label="Report status">
    <a class="tabs__tab" href="/admin/reports" <%- status === 'open' ? 'aria-current="page"' : '' %>>Open (<%= openReports %>)</a>
    <a class="tabs__tab" href="/admin/reports?status=resolved" <%- status === 'resolved' ? 'aria-current="page"' : '' %>>Resolved</a>
  </nav>

  <% if (reports.length) { %>
    <ol class="report-list">
      <% reports.forEach(function (r) { %>
        <li class="card report">
          <div class="report__head">
            <span>#<%= r.id %> · <strong><%= r.reporter %></strong> reported a message from
              <% if (r.sender_id) { %><a href="/admin/players/<%= r.sender_id %>"><strong><%= r.sender %></strong></a><% } else { %>a deleted account<% } %></span>
            <span class="feed__time"><%= r.ago %></span>
          </div>
          <% if (r.reason) { %><p class="report__reason">Reason: “<%= r.reason %>”</p><% } %>
          <div class="report__body bb-content"><%- r.html %></div>
          <% if (status === 'open') { %>
            <form method="post" action="/admin/reports/<%= r.id %>/resolve" class="report__actions">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="visually-hidden" for="note-<%= r.id %>">Note</label>
              <input id="note-<%= r.id %>" name="note" maxlength="300" placeholder="Note for the audit log (optional)">
              <button class="btn btn--ghost btn--sm" type="submit" name="resolution" value="dismissed">Dismiss</button>
              <button class="btn btn--primary btn--sm" type="submit" name="resolution" value="actioned">Mark actioned</button>
            </form>
          <% } else { %>
            <p class="muted report__resolved">Resolved by <%= r.resolver || 'an admin' %> <%= r.resolvedAgo %>: <%= r.resolution %></p>
          <% } %>
        </li>
      <% }) %>
    </ol>
  <% } else { %>
    <p class="card muted"><%= status === 'open' ? 'No open reports.' : 'No resolved reports yet.' %></p>
  <% } %>
</main>

<%- include('../partials/foot') %>
