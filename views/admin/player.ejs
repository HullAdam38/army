<%- include('../partials/head', { bodyClass: 'page-game page-admin' }) %>
<%- include('../partials/header') %>
<% const money = (n) => '$' + Number(n).toLocaleString('en-US'); %>

<main id="main" class="container game-main">
  <%- include('../partials/admin-nav', { active: 'players' }) %>
  <a class="back-link" href="/admin/players"><svg aria-hidden="true"><use href="#i-arrow"/></svg>All players</a>

  <section class="card profile-hero" aria-labelledby="who">
    <% if (avatar) { %><%- include('../partials/avatar', { url: avatar.url, size: 'lg', eager: true, alt: `${t.username}'s avatar` }) %><% } else { %><span class="stat__grade stat__grade--xl"><%= rank.grade %></span><% } %>
    <div class="profile-hero__body">
      <p class="eyebrow">Player #<%= t.id %></p>
      <h1 id="who" class="profile-hero__name"><%= t.username %></h1>
      <p class="profile-hero__rank"><%= rank.name %> (<%= rank.grade %>) · Level <%= t.level %><% if (t.is_admin) { %> · <span class="tag">Admin</span><% } %></p>
      <ul class="profile-hero__meta">
        <li><%= t.email %></li>
        <li><a href="/profile/<%= encodeURIComponent(t.username) %>">Public profile</a></li>
        <% if (t.banned_at) { %><li><span class="status status--hospital">Suspended <%= ago(t.banned_at) %>: <%= t.ban_reason %></span></li><% } %>
      </ul>
    </div>
  </section>

  <dl class="admin-stats">
    <div><dt>Cash</dt><dd><%= money(t.cash) %></dd></div>
    <div><dt>Bank</dt><dd><%= money(t.bank_balance) %></dd></div>
    <div><dt>XP</dt><dd><%= view.xp %> / <%= view.xpNeeded %></dd></div>
    <div><dt>True rating</dt><dd><%= rating %></dd></div>
    <div><dt>Str / Agi / End</dt><dd><%= trainingPoints.strength %> / <%= trainingPoints.agility %> / <%= trainingPoints.endurance %></dd></div>
    <div><dt>Energy</dt><dd><%= t.energy %> / <%= t.max_energy %></dd></div>
    <div><dt>Health</dt><dd><%= t.health %> / <%= t.max_health %><%= view.hospitalized ? ' · hospital' : '' %></dd></div>
    <div><dt>Missions W–L</dt><dd><%= t.missions_completed %>–<%= t.missions_failed %></dd></div>
    <div><dt>PvP W–L</dt><dd><%= t.pvp_wins %>–<%= t.pvp_losses %></dd></div>
    <div><dt>Signed up</dt><dd class="small"><%= fmt(t.created_at) %> <span class="muted">(<%= ago(t.created_at) %>)</span></dd></div>
    <div title="Time between their page views and actions; a break of over 10 minutes ends a session. Background polls from an open tab don't count."><dt>Time played</dt><dd class="small"><%= duration(t.play_ms) %><% if (t.play_sessions) { %> <span class="muted">· <%= t.play_sessions %> session<%= t.play_sessions === 1 ? '' : 's' %>, about <%= duration(t.play_ms / t.play_sessions) %> each</span><% } %></dd></div>
    <div><dt>Last sign-in</dt><dd class="small"><%= fmt(t.last_login_at) %></dd></div>
    <div><dt>Last active</dt><dd class="small"><%= t.last_active_at ? `${fmt(t.last_active_at)} (${ago(t.last_active_at)})` : ago(t.last_seen_at) %></dd></div>
  </dl>

  <div class="admin-grid">
    <section class="card" aria-labelledby="cash-title">
      <h2 id="cash-title" class="card__title">Adjust cash</h2>
      <form method="post" action="/admin/players/<%= t.id %>/cash" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field-row">
          <div class="field"><label for="amount">Amount (negative removes)</label><input id="amount" name="amount" inputmode="numeric" placeholder="500 or -500" required></div>
          <div class="field"><label for="cash-reason">Reason</label><input id="cash-reason" name="reason" maxlength="200" placeholder="Compensation for bug" required></div>
        </div>
        <button class="btn btn--primary btn--sm" type="submit">Apply</button>
      </form>
    </section>

    <section class="card" aria-labelledby="level-title">
      <h2 id="level-title" class="card__title">Set level</h2>
      <form method="post" action="/admin/players/<%= t.id %>/level" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field-row">
          <div class="field"><label for="level">Level (1–<%= maxLevel %>)</label><input id="level" name="level" type="number" min="1" max="<%= maxLevel %>" value="<%= t.level %>" required></div>
          <div class="field"><label for="level-reason">Reason</label><input id="level-reason" name="reason" maxlength="200" placeholder="Testing" required></div>
        </div>
        <p class="field__hint">Resets XP to 0 and sets energy/health caps for that level, refilled.</p>
        <button class="btn btn--primary btn--sm" type="submit">Set level</button>
      </form>
    </section>

    <section class="card" aria-labelledby="restore-title">
      <h2 id="restore-title" class="card__title">Restore</h2>
      <p class="muted">Refill energy and health and release from hospital.</p>
      <form method="post" action="/admin/players/<%= t.id %>/restore" class="admin-inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost btn--sm" type="submit">Restore account</button>
      </form>
    </section>

    <% const canEditIdentity = !t.is_admin || isSelf; %>
    <section class="card" aria-labelledby="identity-title">
      <h2 id="identity-title" class="card__title">Callsign &amp; email</h2>
      <% if (!canEditIdentity) { %>
        <p class="muted">Another admin’s callsign and email can only be changed on the server.</p>
      <% } else { %>
        <form method="post" action="/admin/players/<%= t.id %>/identity" class="form admin-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="field" value="username">
          <div class="field-row">
            <div class="field"><label for="new-name">Callsign</label><input id="new-name" name="value" value="<%= t.username %>" minlength="3" maxlength="20" pattern="[A-Za-z0-9_\-]{3,20}" required autocomplete="off"></div>
            <div class="field"><label for="name-reason">Reason (shown to them)</label><input id="name-reason" name="reason" maxlength="200" placeholder="Offensive callsign" required></div>
          </div>
          <button class="btn btn--ghost btn--sm" type="submit">Rename</button>
        </form>
        <form method="post" action="/admin/players/<%= t.id %>/identity" class="form admin-form admin-form--gap">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="field" value="email">
          <div class="field-row">
            <div class="field"><label for="new-email">Email (they sign in with it)</label><input id="new-email" name="value" type="email" value="<%= t.email %>" maxlength="254" required autocomplete="off"></div>
            <div class="field"><label for="email-reason">Reason</label><input id="email-reason" name="reason" maxlength="200" placeholder="Player asked by email" required></div>
          </div>
          <button class="btn btn--ghost btn--sm" type="submit">Change email</button>
        </form>
      <% } %>
    </section>

    <section class="card" aria-labelledby="bank-title">
      <h2 id="bank-title" class="card__title">Adjust bank</h2>
      <form method="post" action="/admin/players/<%= t.id %>/bank" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field-row">
          <div class="field"><label for="bank-amount">Amount (negative removes)</label><input id="bank-amount" name="amount" inputmode="numeric" placeholder="500 or -500" required></div>
          <div class="field"><label for="bank-reason">Reason</label><input id="bank-reason" name="reason" maxlength="200" placeholder="Refund" required></div>
        </div>
        <button class="btn btn--primary btn--sm" type="submit">Apply</button>
      </form>
    </section>

    <section class="card" aria-labelledby="xp-title">
      <h2 id="xp-title" class="card__title">Grant XP</h2>
      <form method="post" action="/admin/players/<%= t.id %>/xp" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field-row">
          <div class="field"><label for="xp-amount">XP</label><input id="xp-amount" name="amount" inputmode="numeric" placeholder="1000" required></div>
          <div class="field"><label for="xp-reason">Reason</label><input id="xp-reason" name="reason" maxlength="200" placeholder="Event prize" required></div>
        </div>
        <p class="field__hint">Levels up as if earned in play, with the usual promotion notices. Use Set level to go down.</p>
        <button class="btn btn--primary btn--sm" type="submit">Grant</button>
      </form>
    </section>

    <section class="card" aria-labelledby="stats-title">
      <h2 id="stats-title" class="card__title">Trained stats</h2>
      <form method="post" action="/admin/players/<%= t.id %>/stats" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field-row field-row--3">
          <div class="field"><label for="st-str">Strength</label><input id="st-str" name="stat_str" type="number" min="0" max="<%= statCap %>" value="<%= t.stat_str || 0 %>" required></div>
          <div class="field"><label for="st-agi">Agility</label><input id="st-agi" name="stat_agi" type="number" min="0" max="<%= statCap %>" value="<%= t.stat_agi || 0 %>" required></div>
          <div class="field"><label for="st-end">Endurance</label><input id="st-end" name="stat_end" type="number" min="0" max="<%= statCap %>" value="<%= t.stat_end || 0 %>" required></div>
        </div>
        <div class="field"><label for="st-reason">Reason</label><input id="st-reason" name="reason" maxlength="200" placeholder="Training bug refund" required></div>
        <p class="field__hint">Each stat can go up to <%= statCap %> at level <%= t.level %>. Endurance also changes max health.</p>
        <button class="btn btn--primary btn--sm" type="submit">Save stats</button>
      </form>
    </section>

    <section class="card admin-grid__wide" id="supporter" aria-labelledby="sup-title">
      <h2 id="sup-title" class="card__title">Supporter membership</h2>
      <p><% if (supporterInfo.active) { %><span class="tag tag--supporter">Supporter</span> until <%= supporterInfo.until %> · <%= supporterInfo.source === 'admin' ? 'a gift from HQ' : `paid (${supporterInfo.status})` %><% } else { %><span class="muted">Not a Supporter<%= supporterInfo.until ? ` (last until ${supporterInfo.until})` : '' %>.</span><% } %></p>
      <form method="post" action="/admin/players/<%= t.id %>/supporter" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field-row">
          <div class="field"><label for="sup-days">Gift (days)</label><input id="sup-days" name="days" type="number" min="1" max="3660" value="30"></div>
          <div class="field"><label for="sup-reason">Reason</label><input id="sup-reason" name="reason" maxlength="200" placeholder="Competition prize" required></div>
        </div>
        <div class="unit-command__actions">
          <button class="btn btn--ghost btn--sm" type="submit" name="action" value="gift">Give membership</button>
          <% if (supporterInfo.active && supporterInfo.source === 'admin') { %><button class="btn btn--ghost btn--sm btn--danger" type="submit" name="action" value="end">End gift</button><% } %>
        </div>
        <p class="muted small">Paid memberships are cancelled or refunded in Lemon Squeezy; the game hears about it automatically.</p>
      </form>
    </section>

    <section class="card admin-grid__wide" id="cosmetics" aria-labelledby="cos-title">
      <h2 id="cos-title" class="card__title">Cosmetics</h2>
      <% if (cosmeticGrants.length) { %>
        <ul class="admin-gear">
          <% cosmeticGrants.forEach(function (g) { %><li><span><%= g.cosmetic.name %></span><span class="muted"><%= g.source === 'purchase' ? 'bought' : 'given by HQ' %></span></li><% }) %>
        </ul>
      <% } else { %>
        <p class="muted">Hasn’t been given any cosmetics (earned ones unlock by themselves).</p>
      <% } %>
      <form method="post" action="/admin/players/<%= t.id %>/cosmetics" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="cos-item">Cosmetic</label>
          <select id="cos-item" name="cosmetic" required>
            <% cosmeticOptions.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %><%= c.unlock && c.unlock.premium ? ' (Supporter)' : '' %></option><% }) %>
          </select>
        </div>
        <div class="field"><label for="cos-reason">Reason</label><input id="cos-reason" name="reason" maxlength="200" placeholder="Event prize, giveaway, test" required></div>
        <div class="unit-command__actions">
          <button class="btn btn--ghost btn--sm" type="submit" name="action" value="grant">Give</button>
          <button class="btn btn--ghost btn--sm btn--danger" type="submit" name="action" value="revoke">Take back</button>
        </div>
      </form>
    </section>

    <section class="card admin-grid__wide" id="inventory" aria-labelledby="inv-title">
      <h2 id="inv-title" class="card__title">Gear and vehicles</h2>
      <% if (inventory.length) { %>
        <ul class="admin-gear">
          <% inventory.forEach(function (i) { %><li><span><%= i.name %></span><span class="muted">Lv <%= i.minLevel %> · <%= i.slot %><%= i.equipped ? ' · equipped' : '' %></span></li><% }) %>
        </ul>
      <% } else { %>
        <p class="muted">Owns no gear.</p>
      <% } %>
      <% if (vehiclesOwned.length) { %>
        <ul class="admin-gear">
          <% vehiclesOwned.forEach(function (v) { %><li><span><%= v.name %></span><span class="muted">Lv <%= v.minLevel %> · vehicle · <%= v.condition %>%<%= v.out ? ' · taken out' : '' %></span></li><% }) %>
        </ul>
      <% } %>
      <% if (materials.length) { %>
        <p class="muted small">Workshop materials: <%= materials.map((m) => `${m.qty.toLocaleString('en-US')} ${m.name}`).join(' · ') %></p>
      <% } %>
      <div class="admin-gear__forms">
        <% if (grantable.length || vehiclesGrantable.length) { %>
          <form method="post" action="/admin/players/<%= t.id %>/items" class="form admin-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="action" value="grant">
            <div class="field"><label for="give-item">Give an item</label>
              <select id="give-item" name="item" required>
                <% grantable.forEach(function (s) { %><optgroup label="<%= s.label %>"><% s.items.forEach(function (i) { %><option value="<%= i.id %>"><%= i.name %> (Lv <%= i.minLevel %>)</option><% }) %></optgroup><% }) %>
                <% if (vehiclesGrantable.length) { %><optgroup label="Vehicles"><% vehiclesGrantable.forEach(function (v) { %><option value="veh:<%= v.id %>"><%= v.name %> (Lv <%= v.minLevel %>)</option><% }) %></optgroup><% } %>
              </select>
            </div>
            <div class="field"><label for="give-reason">Reason</label><input id="give-reason" name="reason" maxlength="200" placeholder="Lost item after bug" required></div>
            <button class="btn btn--ghost btn--sm" type="submit">Give</button>
          </form>
        <% } %>
        <% if (inventory.length || vehiclesOwned.length) { %>
          <form method="post" action="/admin/players/<%= t.id %>/items" class="form admin-form" data-confirm="Take this away? It's unequipped first.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="action" value="remove">
            <div class="field"><label for="take-item">Take an item</label>
              <select id="take-item" name="item" required>
                <% inventory.forEach(function (i) { %><option value="<%= i.id %>"><%= i.name %><%= i.equipped ? ' (equipped)' : '' %></option><% }) %>
                <% if (vehiclesOwned.length) { %><optgroup label="Vehicles"><% vehiclesOwned.forEach(function (v) { %><option value="veh:<%= v.id %>"><%= v.name %><%= v.out ? ' (taken out)' : '' %></option><% }) %></optgroup><% } %>
              </select>
            </div>
            <div class="field"><label for="take-reason">Reason</label><input id="take-reason" name="reason" maxlength="200" placeholder="Bought through an exploit" required></div>
            <button class="btn btn--ghost btn--sm btn--danger" type="submit">Take away</button>
          </form>
        <% } %>
        <% if (materials.length) { %>
          <form method="post" action="/admin/players/<%= t.id %>/materials" class="form admin-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="mat-id">Workshop materials</label>
              <select id="mat-id" name="material" required>
                <% materials.forEach(function (m) { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
              </select>
            </div>
            <div class="field"><label for="mat-qty">Amount (negative takes away)</label><input id="mat-qty" name="qty" type="number" min="-100000" max="100000" step="1" value="10" required></div>
            <div class="field"><label for="mat-reason">Reason</label><input id="mat-reason" name="reason" maxlength="200" placeholder="Event prize" required></div>
            <button class="btn btn--ghost btn--sm" type="submit">Apply</button>
          </form>
        <% } %>
      </div>
    </section>

    <section class="card" aria-labelledby="unit-title">
      <h2 id="unit-title" class="card__title">Unit</h2>
      <% if (unit) { %>
        <p><a href="/units/<%= unit.id %>"><strong>[<%= unit.tag %>] <%= unit.name %></strong></a> <span class="muted">· <%= t.unit_role %></span></p>
        <% if (t.unit_role === 'leader') { %>
          <p class="muted">They’re the Commander. To remove them, transfer command or disband the unit from its page.</p>
        <% } else { %>
          <form method="post" action="/admin/players/<%= t.id %>/unit-remove" class="form admin-form admin-form--gap" data-confirm="Remove <%= t.username %> from <%= unit.name %>?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="unit-reason">Reason (shown to them)</label><input id="unit-reason" name="reason" maxlength="200" required></div>
            <button class="btn btn--ghost btn--sm" type="submit">Remove from unit</button>
          </form>
        <% } %>
      <% } else { %>
        <p class="muted">Not in a unit.</p>
      <% } %>
    </section>

    <section class="card" aria-labelledby="mod-title">
      <h2 id="mod-title" class="card__title">Title, chat &amp; sessions</h2>
      <ul class="admin-list admin-modlist">
        <li>Title: <% if (titleName) { %><strong><%= titleName %></strong>
          <form method="post" action="/admin/players/<%= t.id %>/clear-title" class="admin-inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost btn--xs" type="submit">Clear</button></form>
          <% } else { %><span class="muted">none</span><% } %></li>
        <li>Chat: <% if (muted) { %><strong>muted</strong>, <%= muted.left %> left<%= muted.reason ? ` (${muted.reason})` : '' %>
          <form method="post" action="/admin/chat/unmute/<%= t.id %>" class="admin-inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost btn--xs" type="submit">Unmute</button></form>
          <% } else { %><span class="muted">not muted</span> · <a href="/admin/chat">chat moderation</a><% } %></li>
        <li>Notifications: <% if (notifications.total) { %><strong><%= notifications.total %></strong><%= notifications.unread ? ` (${notifications.unread} unread)` : '' %>
          <form method="post" action="/admin/players/<%= t.id %>/clear-notifications" class="admin-inline-form" data-confirm="Delete all <%= notifications.total %> of <%= t.username %>’s notifications? This can’t be undone."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost btn--xs" type="submit">Clear</button></form>
          <% } else { %><span class="muted">none</span><% } %></li>
        <% if (avatar) { %><li>Avatar: <%= avatar.kind === 'upload' ? 'uploaded picture' : avatar.kind === 'badge' ? 'badge' : 'starting badge' %><%= avatar.uploadsBlocked ? ' · uploads blocked' : '' %> · <a href="/admin/avatars?tab=recent">avatar moderation</a></li><% } %>
      </ul>
      <% if (!isSelf) { %>
        <form method="post" action="/admin/players/<%= t.id %>/sign-out" class="admin-inline" data-confirm="Sign <%= t.username %> out on every device?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit">Sign out everywhere</button>
        </form>
      <% } %>
    </section>

    <section class="card" aria-labelledby="pw-title">
      <h2 id="pw-title" class="card__title">Password</h2>
      <% if (isSelf || t.is_admin) { %>
        <p class="muted"><%= isSelf ? 'Use Change password on your own profile.' : 'Admin passwords can’t be reset from here.' %></p>
      <% } else { %>
        <p class="muted">Issue a 24-hour temporary password. <%= t.username %> is signed out and must choose a new password at their next sign-in.<% if (t.must_change_password) { %> <strong>A temporary password is already pending.</strong><% } %></p>
        <form method="post" action="/admin/players/<%= t.id %>/reset-password" class="admin-inline" data-confirm="Reset <%= t.username %>'s password? Their current password will stop working.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit">Reset password</button>
        </form>
      <% } %>
    </section>

    <section class="card" aria-labelledby="bio-title">
      <h2 id="bio-title" class="card__title">Profile bio</h2>
      <% if (t.bio) { %>
        <div class="admin-bio bb-content"><%- bioHtml %></div>
        <form method="post" action="/admin/players/<%= t.id %>/clear-bio" class="admin-inline" data-confirm="Clear <%= t.username %>'s bio? They'll be notified.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit">Clear bio</button>
        </form>
      <% } else { %>
        <p class="muted">No bio.</p>
      <% } %>
    </section>

    <section class="card" aria-labelledby="msg-title">
      <h2 id="msg-title" class="card__title">Send a message</h2>
      <form method="post" action="/admin/players/<%= t.id %>/notify" class="form admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="message">Arrives as a notification</label><textarea id="message" name="message" rows="2" maxlength="300" required></textarea></div>
        <button class="btn btn--ghost btn--sm" type="submit">Send</button>
      </form>
    </section>

    <section class="card admin-grid__wide admin-danger" aria-labelledby="ban-title">
      <h2 id="ban-title" class="card__title">Suspension</h2>
      <% if (isSelf || t.is_admin) { %>
        <p class="muted">Admins can't be suspended from here.</p>
      <% } else if (t.banned_at) { %>
        <form method="post" action="/admin/players/<%= t.id %>/unban" class="admin-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <p>Suspended <%= fmt(t.banned_at) %> for: <strong><%= t.ban_reason %></strong></p>
          <button class="btn btn--ghost btn--sm" type="submit">Lift suspension</button>
        </form>
      <% } else { %>
        <form method="post" action="/admin/players/<%= t.id %>/ban" class="form admin-form" data-confirm="Suspend <%= t.username %>? They'll be signed out immediately.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="ban-reason">Reason (shown to the player)</label><input id="ban-reason" name="reason" maxlength="200" placeholder="Multiple accounts" required></div>
          <button class="btn btn--danger btn--sm" type="submit">Suspend and sign out</button>
        </form>
      <% } %>
    </section>

    <section class="card admin-grid__wide" aria-labelledby="activity-title">
      <h2 id="activity-title" class="card__title">Activity, last 24 hours</h2>
      <p class="muted"><%= activity.totals.n %> actions in <%= activity.totals.active %> of 24 hours · <%= activity.totals.xp %> XP · $<%= activity.totals.cash.toLocaleString('en-US') %> earned. Real people sleep; a solid wall of bars is a warning sign.</p>
      <ol class="hour-strip" aria-label="Actions per hour, oldest on the left">
        <% activity.hours.forEach(function (h) { const label = new Date(h.at).toISOString().slice(11, 16) + ' UTC'; %>
          <li title="<%= label %>: <%= h.n %> actions, <%= h.xp %> XP, $<%= h.cash %>">
            <span class="hour-strip__bar" style="height:<%= Math.round((h.n / activity.peak) * 100) %>%"></span>
            <span class="visually-hidden"><%= label %>: <%= h.n %> actions</span>
          </li>
        <% }) %>
      </ol>
      <div class="hour-strip__axis"><span>24h ago</span><span>12h ago</span><span>now</span></div>
    </section>

    <section class="card admin-grid__wide" aria-labelledby="ac-title">
      <h2 id="ac-title" class="card__title">Anti-cheat</h2>
      <div class="ac-grid">
        <div>
          <h3 class="ac-sub">Linked accounts (last 30 days)</h3>
          <% if (links.length) { %>
            <ul class="admin-list"><% links.forEach(function (l) { %>
              <li><a href="/admin/players/<%= l.other_id %>"><strong><%= l.other_name %></strong></a> <span class="tag <%= l.device ? 'tag--hospital' : '' %>"><%= l.device ? 'same device' : 'same network' %></span> <span class="muted"><%= l.ago %></span></li>
            <% }) %></ul>
          <% } else { %><p class="muted">None.</p><% } %>
          <h3 class="ac-sub">Flags</h3>
          <% if (flags.length) { %>
            <ul class="admin-list"><% flags.forEach(function (f) { %>
              <li><span class="sev sev--<%= SEVERITY[f.severity] %>"><%= SEVERITY[f.severity] %></span> <a href="/admin/flags/<%= f.id %>"><%= RULES[f.rule] || f.rule %></a> <span class="muted"><%= f.status %></span></li>
            <% }) %></ul>
          <% } else { %><p class="muted">None.</p><% } %>
          <h3 class="ac-sub">Recent sign-ins</h3>
          <% if (signIns.length) { %>
            <ul class="admin-list mono"><% signIns.forEach(function (s) { %>
              <li title="<%= s.user_agent %>">device <%= (s.device_id || '—').slice(0, 8) %> · network <%= (s.ip_hash || 'local').slice(0, 8) %> · <span class="muted"><%= s.ago %></span></li>
            <% }) %></ul>
          <% } else { %><p class="muted">None recorded.</p><% } %>
        </div>
        <div>
          <h3 class="ac-sub">Money history (latest first)</h3>
          <% if (ledger.length) { %>
            <ol class="ledger-mini"><% ledger.forEach(function (l) { %>
              <li class="<%= l.reason === 'unknown' ? 'is-bad' : '' %>">
                <span class="ledger-mini__reason"><%= l.reason %><%= l.ref ? ` · ${l.ref}` : '' %></span>
                <span class="ledger-mini__amt"><% if (l.delta_cash) { %>cash <%= l.delta_cash > 0 ? '+' : '' %><%= l.delta_cash %><% } %><% if (l.delta_bank) { %> bank <%= l.delta_bank > 0 ? '+' : '' %><%= l.delta_bank %><% } %></span>
                <span class="muted"><%= l.ago %></span>
              </li>
            <% }) %></ol>
          <% } else { %><p class="muted">No entries.</p><% } %>
        </div>
      </div>
    </section>

    <section class="card admin-grid__wide" aria-labelledby="hist-title">
      <h2 id="hist-title" class="card__title">Admin history for <%= t.username %></h2>
      <% if (history.length) { %>
        <ol class="audit">
          <% history.forEach(function (a) { %>
            <li class="audit__row">
              <span class="audit__action audit__action--<%= a.action %>"><%= a.action %></span>
              <span class="audit__text"><strong><%= a.admin_name %></strong>: <%= a.details %></span>
              <span class="audit__time"><%= a.ago %></span>
            </li>
          <% }) %>
        </ol>
      <% } else { %>
        <p class="muted">No admin actions on this player.</p>
      <% } %>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
