<%- include('../partials/head', { bodyClass: 'page-game page-admin' }) %>
<%- include('../partials/header') %>

<main id="main" class="container game-main">
  <%- include('../partials/admin-nav', { active: 'players' }) %>
  <a class="back-link" href="/admin/players/<%= t.id %>"><svg aria-hidden="true"><use href="#i-arrow"/></svg><%= t.username %></a>
  <section class="card temp-pass" aria-labelledby="tp-title">
    <p class="eyebrow">Password reset</p>
    <h1 id="tp-title" class="page-head__title">Temporary password for <%= t.username %></h1>
    <p class="temp-pass__code" aria-label="Temporary password"><%= temp %></p>
    <ul class="temp-pass__notes">
      <li><strong>This is the only time it's shown.</strong> It isn't stored anywhere you can view it again.</li>
      <li>Send it to <%= t.username %> privately (not in a public chat). It expires in 24 hours.</li>
      <li>When they sign in with it, they must choose a new password before they can play.</li>
      <li><%= t.username %> has been signed out everywhere.</li>
    </ul>
    <a class="btn btn--primary" href="/admin/players/<%= t.id %>">Done</a>
  </section>
</main>

<%- include('../partials/foot') %>
