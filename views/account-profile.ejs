<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>

<main id="main" class="container game-main">
  <a class="back-link reveal" style="--i:0" href="/profile/<%= encodeURIComponent(player.username) %>"><svg aria-hidden="true"><use href="#i-arrow"/></svg>Your profile</a>
  <div class="page-head reveal" style="--i:0">
    <div>
      <p class="eyebrow">Service record</p>
      <h1 class="page-head__title">Edit profile</h1>
      <p class="page-head__sub">Your bio shows on your public profile. Use the toolbar to format it. Keep it within the conduct rules in the <a href="/terms#conduct">Terms of Service</a>: moderators can remove bios that break them.</p>
    </div>
  </div>

  <section class="card compose reveal" style="--i:1">
    <form method="post" action="/account/profile" class="compose__form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('partials/bb-editor', { id: 'bio', name: 'bio', label: 'Bio', value: bio, max: maxBio, rows: 10, required: false, placeholder: 'Who are you on the battlefield?' }) %>
      <div class="compose__actions">
        <button class="btn btn--primary" type="submit">Save profile</button>
        <a class="btn btn--ghost" href="/profile/<%= encodeURIComponent(player.username) %>">Cancel</a>
        <span class="muted compose__hint">Leave it empty to remove your bio.</span>
      </div>
    </form>
  </section>

  <section class="card title-picker reveal" style="--i:2" id="title" aria-labelledby="title-heading">
    <h2 class="card__title" id="title-heading">Title</h2>
    <% const earned = titles.filter((t) => t.earned); %>
    <p class="muted">Pick a title to show under your callsign on your profile and in chat. You earn titles by playing; locked ones show how.</p>
    <form method="post" action="/account/title">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset class="title-grid">
        <legend class="visually-hidden">Choose a title</legend>
        <label class="title-opt<%= !currentTitle ? ' is-current' : '' %>">
          <input type="radio" name="title" value="" <%- !currentTitle ? 'checked' : '' %>>
          <span class="title-opt__name">No title</span>
          <span class="title-opt__how">Just your rank.</span>
        </label>
        <% titles.forEach(function (t) { %>
          <label class="title-opt<%= t.earned ? '' : ' is-locked' %><%= currentTitle === t.id ? ' is-current' : '' %>">
            <input type="radio" name="title" value="<%= t.id %>" <%- currentTitle === t.id ? 'checked' : '' %> <%- t.earned ? '' : 'disabled' %>>
            <span class="title-opt__name"><% if (!t.earned) { %><svg aria-hidden="true"><use href="#i-lock"/></svg><% } %><%= t.name %></span>
            <span class="title-opt__how"><%= t.earned ? 'Earned' : t.how %></span>
          </label>
        <% }) %>
      </fieldset>
      <div class="compose__actions">
        <button class="btn btn--primary" type="submit" <%- earned.length ? '' : 'disabled' %>>Save title</button>
        <span class="muted compose__hint"><%= earned.length %> of <%= titles.length %> earned</span>
      </div>
    </form>
  </section>
</main>

<%- include('partials/foot') %>
