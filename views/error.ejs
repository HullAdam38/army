<%- include('partials/head', { bodyClass: 'page-error' }) %>
<%- include('partials/header') %>

<main id="main" class="container error-page">
  <p class="error-page__code reveal" style="--i:0"><%= status %></p>
  <h1 class="error-page__title reveal" style="--i:1"><%= status === 404 ? 'Off the map' : 'Mission aborted' %></h1>
  <p class="reveal" style="--i:2"><%= message %></p>
  <a class="btn btn--primary reveal" style="--i:3" href="<%= signedIn ? '/hq' : '/' %>">Return to base</a>
</main>

<%- include('partials/foot') %>
