<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>

<main id="main" class="container game-main">
  <div class="page-head reveal" style="--i:0">
    <div>
      <p class="eyebrow">Support the game</p>
      <h1 class="page-head__title">Supporter membership</h1>
      <p class="page-head__sub">GeneralForces is free to play and always will be. A Supporter membership pays for the servers and new features, and gives you a few looks to show for it. It never gives power, cash or anything that changes a fight.</p>
    </div>
  </div>

  <section class="card supporter-status reveal" style="--i:1" aria-labelledby="status-title">
    <h2 id="status-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-star"/></svg>Your membership</h2>
    <% if (active) { %>
      <p class="supporter-status__line"><span class="tag tag--supporter">Supporter</span>
        <span><% if (me.source === 'admin') { %>A gift from HQ, until <strong><%= me.until %></strong>.<% } else if (me.cancelled) { %>Cancelled: your perks last until <strong><%= me.until %></strong>.<% } else if (me.pastDue) { %>Your last payment didn’t go through. Update your payment details to keep your perks (they last until <strong><%= me.until %></strong>).<% } else { %>Active, renewing around <strong><%= me.until %></strong>.<% } %></span>
      </p>
      <% if (me.since) { %><p class="muted small">Supporting since <%= me.since %>. Thank you.</p><% } %>
      <% if (manage) { %><p><a class="btn btn--ghost btn--sm" href="<%= manage %>" rel="noopener" target="_blank">Manage or cancel</a> <span class="muted small">Opens the payment provider’s page; sign in with the email you paid with.</span></p><% } %>
    <% } else if (open) { %>
      <p class="supporter-status__price"><%= price || 'Monthly membership' %></p>
      <p class="muted small">Cancel any time from the payment page; your perks last to the end of the month you’ve paid for.</p>
      <a class="btn btn--primary" href="/supporter/join">Become a Supporter</a>
      <p class="muted small supporter-status__fine">Payments are handled by Lemon Squeezy, who sell the membership for us as merchant of record and handle tax and refunds. You’ll leave the game to pay, then come back. See <a href="/terms#purchases">Purchases</a> in the Terms.</p>
    <% } else { %>
      <p>Supporter membership opens soon.</p>
      <p class="muted small">Some Supporter looks can already be seen in your <a href="/account/wardrobe">wardrobe</a>.</p>
    <% } %>
  </section>

  <section class="reveal" style="--i:2" aria-labelledby="perks-title">
    <h2 id="perks-title" class="section-title">What Supporters get</h2>
    <ul class="supporter-perks">
      <% perks.forEach(function (p) { %>
        <li class="card supporter-perk">
          <svg class="supporter-perk__icon" aria-hidden="true"><use href="#<%= p.icon %>"/></svg>
          <h3 class="supporter-perk__title"><%= p.title %></h3>
          <p class="muted"><%= p.text %></p>
        </li>
      <% }) %>
    </ul>
  </section>
</main>

<%- include('partials/foot') %>
