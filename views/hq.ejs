<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>
<%
  const fmtTime = (ms) => new Date(ms).toISOString().slice(11, 16).replace(':', '') + 'Z';
%>

<main id="main" class="container game-main">
  <div class="page-head reveal" style="--i:0">
    <div class="hq-hello">
      <a class="hq-hello__avatar" href="/account/avatar" title="Change your avatar"><%- include('partials/avatar', { url: player.avatarUrl, size: 'md', eager: true, alt: 'Your avatar' }) %></a>
      <div>
        <p class="eyebrow">Headquarters</p>
        <h1 class="page-head__title">Welcome back, <span class="accent"><%= player.username %></span>.</h1>
      </div>
    </div>
    <a class="btn btn--primary" href="/missions">View missions <svg class="btn__icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
  </div>

  <% if (update) { %>
    <p class="event-upcoming hq-update reveal" style="--i:1">
      <svg aria-hidden="true"><use href="#i-mail"/></svg>
      <span>New update: <a href="/updates#u-<%= update.id %>"><strong><%= update.title %></strong></a>. Read what’s changed.</span>
    </p>
  <% } %>
  <% if (tip && (training.graduated || training.dismissed)) { %>
    <div class="field-tip reveal" style="--i:1">
      <svg aria-hidden="true"><use href="#i-star"/></svg>
      <p class="field-tip__text"><strong><%= tip.title %>.</strong> <%= tip.text %> <a href="<%= tip.link %>"><%= tip.cta %></a></p>
      <form method="post" action="/guide/hide/<%= tip.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost btn--sm" type="submit" aria-label="Hide this tip">Got it</button></form>
    </div>
  <% } %>
  <% if (upcomingEvents.length) { %>
    <p class="event-upcoming reveal" style="--i:1">
      <svg aria-hidden="true"><use href="#i-star"/></svg>
      Coming up: <% upcomingEvents.forEach(function (e, i) { %><a href="/events"><strong><%= e.title %></strong></a> in <span data-until="<%= e.starts_at %>">soon</span><%= i < upcomingEvents.length - 1 ? ' · ' : '' %><% }) %>
    </p>
  <% } %>
  <% if (target) { %><%- include('partials/hvt-card', { t: target, back: '/hq' }) %><% } %>
  <div class="hq-grid">
    <% if (!training.graduated && !training.dismissed) { %>
      <section class="card hq-card hq-card--training reveal" style="--i:1" aria-labelledby="training-title">
        <div class="training__head">
          <div>
            <h2 id="training-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-chevrons"/></svg>Basic training</h2>
            <p class="training__lead">
              <% if (training.next) { %>Next: <strong><%= training.next.title %></strong>. <%= training.next.hint %><% } %>
            </p>
          </div>
          <div class="training__progress">
            <span class="training__count"><%= training.count %><small>/<%= training.total %></small></span>
            <span class="meter meter--xp" role="progressbar" aria-label="Basic training progress" aria-valuemin="0" aria-valuemax="<%= training.total %>" aria-valuenow="<%= training.count %>"><span class="meter__fill" style="width:<%= training.pct %>%"></span></span>
          </div>
        </div>
        <ol class="training-steps">
          <% training.steps.forEach(function (s, i) { %>
            <li class="training-step<%= s.done ? ' is-done' : '' %><%= training.next && training.next.id === s.id ? ' is-next' : '' %>">
              <span class="training-step__mark" aria-hidden="true"><%= s.done ? '✓' : i + 1 %></span>
              <span class="training-step__text"><%= s.title %><span class="visually-hidden"><%= s.done ? ' (done)' : '' %></span></span>
              <span class="training-step__reward">+$<%= s.cash %><%= s.xp ? ` · ${s.xp} XP` : '' %></span>
              <% if (!s.done) { %><a class="btn btn--sm <%= training.next && training.next.id === s.id ? 'btn--primary' : 'btn--ghost' %>" href="<%= s.link %>"><%= s.cta %></a><% } %>
            </li>
          <% }) %>
        </ol>
        <div class="training__foot">
          <p class="progress-line__note">Steps tick off by themselves as you play. Finish them all for a $<%= training.bonus.cash %> graduation bonus.</p>
          <form method="post" action="/tutorial/hide">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="unit-post__delete" type="submit">Hide checklist</button>
          </form>
        </div>
      </section>
    <% } %>
    <% if (unitHelp) { %>
      <section class="card hq-card hq-card--units reveal" style="--i:2" aria-labelledby="hq-units-title">
        <h2 id="hq-units-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-flag"/></svg>Join a unit</h2>
        <% if (unitHelp.invites) { %>
          <p><strong>You have <%= unitHelp.invites === 1 ? 'an invitation' : `${unitHelp.invites} invitations` %> to join a unit.</strong></p>
          <a class="btn btn--primary btn--block" href="/units#invites">See invitations</a>
        <% } else { %>
          <p class="muted small">Soldiers in a unit can’t be attacked by each other, and share rally orders, raids and the theatre of war. These units are recruiting players like you:</p>
          <ul class="unit-rec">
            <% unitHelp.recommended.forEach(function (u) { %>
              <li class="unit-rec__item">
                <span class="unit-crest <%= crestClass(u.crest) %>" aria-hidden="true"><%= u.tag %></span>
                <span class="unit-rec__body"><a class="roster__name directory__name" href="/units/<%= u.id %>"><%= u.name %></a><span class="muted small"><%= u.members %> / <%= u.capacity %> members · <%= u.active %> active</span></span>
                <a class="btn btn--ghost btn--sm" href="/units/<%= u.id %>#apply">Apply</a>
              </li>
            <% }) %>
          </ul>
          <a class="btn btn--ghost btn--block" href="/units<%= unitHelp.looking ? '' : '#looking' %>"><%= unitHelp.looking ? 'Browse all units' : 'Or let units invite you' %></a>
        <% } %>
      </section>
    <% } %>
    <section class="card hq-card hq-card--dossier reveal" style="--i:1" aria-labelledby="dossier-title">
      <h2 id="dossier-title" class="card__title">Service record</h2>
      <div class="dossier__who">
        <span class="stat__grade stat__grade--lg"><%= player.grade %></span>
        <div>
          <p class="dossier__name"><%= player.rank %></p>
          <p class="dossier__meta">Level <%= player.level %><%= nextRank ? ` · ${nextRank.name} at level ${nextRank.level}` : ' · highest rank achieved' %></p>
          <% if (nextPerk) { %><p class="dossier__perk">Next rank perk: <%= nextPerk.text %> at level <%= nextPerk.level %></p><% } %>
        </div>
      </div>
      <div class="progress-line">
        <div class="progress-line__label"><span>Experience</span><span><%= player.xp %> / <%= player.xpNeeded %> XP</span></div>
        <span class="meter meter--xp meter--lg" role="progressbar" aria-label="Experience" aria-valuemin="0" aria-valuemax="<%= player.xpNeeded %>" aria-valuenow="<%= player.xp %>">
          <span class="meter__fill" style="width:<%= player.xpPct %>%"></span>
        </span>
      </div>
      <dl class="figures">
        <div><dt>Missions won</dt><dd><%= player.missionsCompleted %></dd></div>
        <div><dt>Missions lost</dt><dd><%= player.missionsFailed %></dd></div>
        <div><dt>Success rate</dt><dd><%= player.successRate === null ? '—' : player.successRate + '%' %></dd></div>
        <div><dt>Combat rating</dt><dd><a class="figure-link" href="/armory"><%= loadout.rating %></a></dd></div>
      </dl>
      <% if (!training.graduated && training.dismissed) { %>
        <form method="post" action="/tutorial/show" class="dossier__training">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="unit-post__delete" type="submit">Show basic training (<%= training.count %>/<%= training.total %>)</button>
        </form>
      <% } %>
      <a class="dossier__medals dossier__base" href="/base"><svg aria-hidden="true"><use href="#i-crest"/></svg><% if (!base.unlocked) { %>Forward base unlocks at level <%= base.unlockLevel %><% } else if (base.building) { %>Base: building <%= base.building.name %>, ready in <span data-until="<%= base.until %>">soon</span><% } else { %>Forward base · rating <%= base.rating %>/<%= base.maxRating %><%= base.rating < base.maxRating ? ' · engineers idle' : '' %><% } %></a>
      <% if (special) { %><a class="dossier__medals dossier__base dossier__special" href="/missions#special"><svg aria-hidden="true"><use href="#i-target"/></svg>Special operation: <%= special.op.name %> · <%= special.run ? `stage ${special.stage} of 3` : 'open now' %> · closes in <span data-until="<%= special.closesAt %>"><%= Math.max(1, Math.round((special.closesAt - Date.now()) / 60000)) %>m</span></a><% } %>
      <a class="dossier__medals dossier__base" href="/deployments"><svg aria-hidden="true"><use href="#i-kit"/></svg><% if (player.deployed) { %>On deployment · back in <span data-until="<%= player.deployedUntil %>">soon</span><% } else { %>Deployments · earn while you’re away<% } %></a>
      <% if (season) { %><a class="dossier__medals dossier__base" href="/seasons"><svg aria-hidden="true"><use href="#i-podium"/></svg>Season <%= season.number %> · <%= season.placed ? `${season.division.name} #${season.rank}` : `placement ${season.fights}/${season.placement}` %> · <%= season.rating.toLocaleString('en-US') %> rating</a><% } %>
      <a class="dossier__medals dossier__base" href="/account/recruit"><svg aria-hidden="true"><use href="#i-mail"/></svg>Recruit a friend · earn $<%= recruitReward.toLocaleString('en-US') %></a>
      <a class="dossier__medals" href="/medals"><svg aria-hidden="true"><use href="#i-star"/></svg><%= medalCount ? `${medalCount} medal${medalCount === 1 ? '' : 's'} earned` : 'No medals yet' %> · Medal case</a>
    </section>

    <section class="card hq-card hq-card--orders reveal" style="--i:2" aria-labelledby="orders-title">
      <h2 id="orders-title" class="card__title">Next mission</h2>
      <% if (nextMission) { %>
        <p class="orders__theatre"><%= nextMission.theatre %></p>
        <p class="orders__name"><%= nextMission.name %></p>
        <p class="orders__brief"><%= nextMission.brief %></p>
        <ul class="chips">
          <li class="chip"><svg aria-hidden="true"><use href="#i-bolt"/></svg><%= nextMission.energy %> energy</li>
          <li class="chip"><svg aria-hidden="true"><use href="#i-target"/></svg><%= nextMission.chancePct %>% success</li>
        </ul>
        <form method="post" action="/missions/<%= nextMission.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--primary btn--block" type="submit">Launch now</button>
        </form>
      <% } else if (player.hospitalized) { %>
        <p class="orders__brief">You're in hospital. Orders resume when you're discharged.</p>
        <a class="btn btn--ghost btn--block" href="/hospital">Go to the ward</a>
      <% } else if (player.deployed) { %>
        <p class="orders__brief">You're out on deployment. Missions resume when you're back in <span data-until="<%= player.deployedUntil %>" data-reload>soon</span>.</p>
        <a class="btn btn--ghost btn--block" href="/deployments">View deployment</a>
      <% } else if (!player.canDeploy) { %>
        <p class="orders__brief">You're too injured for missions. Rest up or visit the field hospital.</p>
      <% } else { %>
        <p class="orders__brief">Energy is too low for any available mission.
          <% if (player.nextEnergyIn !== null) { %>Next energy point in <span data-countdown="energy"><%= player.nextEnergyIn %>s</span>.<% } %>
        </p>
        <a class="btn btn--ghost btn--block" href="/missions">Review missions</a>
      <% } %>
    </section>

    <section class="card hq-card hq-card--daily reveal" style="--i:3" aria-labelledby="daily-title">
      <h2 id="daily-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-star"/></svg>Daily orders <span class="card__title-meta">New orders in <span data-until="<%= Date.now() + daily.resetInMs %>" data-reload>soon</span></span></h2>
      <ol class="daily">
        <% daily.orders.forEach(function (o) { %>
          <li class="daily__order<%= o.claimed ? ' is-claimed' : o.done ? ' is-done' : '' %>">
            <div class="daily__body">
              <div class="progress-line__label"><span class="daily__text"><%= o.text %></span><span><%= o.type === 'mission_cash' ? `$${o.progress.toLocaleString('en-US')} / $${o.target.toLocaleString('en-US')}` : `${o.progress} / ${o.target}` %></span></div>
              <span class="meter meter--xp" role="progressbar" aria-label="<%= o.text %>" aria-valuemin="0" aria-valuemax="<%= o.target %>" aria-valuenow="<%= o.progress %>"><span class="meter__fill" style="width:<%= o.pct %>%"></span></span>
              <p class="daily__reward">+<%= o.reward_xp %> XP · +$<%= o.reward_cash.toLocaleString('en-US') %></p>
            </div>
            <% if (o.claimed) { %>
              <span class="daily__status">Claimed</span>
            <% } else { %>
              <form method="post" action="/daily/orders/<%= o.slot %>/claim">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--sm <%= o.done ? 'btn--primary' : 'btn--ghost' %>" type="submit" <%- o.done ? '' : 'disabled' %>>Claim</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ol>
      <div class="daily__bonus<%= daily.bonusClaimed ? ' is-claimed' : daily.allClaimed ? ' is-ready' : '' %>">
        <div>
          <p class="daily__bonus-title">Commendation</p>
          <p class="daily__reward">Claim all three orders for +<%= daily.bonus.xp %> XP · +$<%= daily.bonus.cash.toLocaleString('en-US') %>. Unclaimed rewards expire at reset (00:00 UTC).</p>
        </div>
        <% if (daily.bonusClaimed) { %>
          <span class="daily__status">Awarded</span>
        <% } else { %>
          <form method="post" action="/daily/bonus/claim">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--sm <%= daily.allClaimed ? 'btn--primary' : 'btn--ghost' %>" type="submit" <%- daily.allClaimed ? '' : 'disabled' %>>Claim</button>
          </form>
        <% } %>
      </div>
    </section>

    <section class="card hq-card hq-card--supply reveal" style="--i:4" aria-labelledby="supply-title">
      <h2 id="supply-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-kit"/></svg>Supply drop</h2>
      <p class="supply__streak"><span class="supply__count"><%= daily.streak.current %></span> day streak<span class="muted"> · best <%= daily.streak.best %></span></p>
      <ol class="supply" aria-label="7-day supply cycle">
        <% daily.streak.days.forEach(function (d) { %>
          <li class="supply__day<%= d.done ? ' is-done' : '' %><%= d.today ? ' is-today' : '' %><%= d.energy ? ' is-big' : '' %>">
            <span class="supply__label">Day <%= d.day %></span>
            <span class="supply__cash">$<%= d.cash.toLocaleString('en-US') %></span>
            <% if (d.energy) { %><span class="supply__extra"><svg aria-hidden="true"><use href="#i-bolt"/></svg>Full energy</span><% } %>
            <% if (d.done) { %><span class="visually-hidden">(received)</span><% } %>
          </li>
        <% }) %>
      </ol>
      <% if (daily.streak.claimedToday) { %>
        <p class="progress-line__note">Today’s drop is in. Next one in <span data-until="<%= Date.now() + daily.resetInMs %>">soon</span>; miss a day and the streak restarts.</p>
      <% } else { %>
        <form method="post" action="/daily/supply/claim">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--primary btn--block" type="submit">Collect day <%= daily.streak.cycleDay %> drop</button>
        </form>
        <p class="progress-line__note"><%= daily.streak.current ? 'Collect before 00:00 UTC to keep your streak.' : 'Collect every day to build a streak. Day 7 also refills your energy.' %></p>
      <% } %>
    </section>

    <section class="card hq-card hq-card--status reveal" style="--i:5" aria-labelledby="status-title">
      <h2 id="status-title" class="card__title">Readiness</h2>
      <div class="progress-line">
        <div class="progress-line__label"><span><svg class="inline-icon inline-icon--energy" aria-hidden="true"><use href="#i-bolt"/></svg>Energy</span><span><%= player.energy %> / <%= player.maxEnergy %></span></div>
        <span class="meter meter--energy meter--lg"><span class="meter__fill" style="width:<%= player.energyPct %>%"></span></span>
        <p class="progress-line__note">
          <% if (player.nextEnergyIn === null) { %>Fully charged.<% } else { %>+1 in <span data-countdown="energy"><%= player.nextEnergyIn %>s</span> · 1 per <%= player.energyRegenSeconds / 60 %> min<% } %>
        </p>
      </div>
      <div class="progress-line">
        <div class="progress-line__label"><span><svg class="inline-icon inline-icon--health" aria-hidden="true"><use href="#i-health"/></svg>Health</span><span><%= player.health %> / <%= player.maxHealth %></span></div>
        <span class="meter meter--health meter--lg"><span class="meter__fill" style="width:<%= player.healthPct %>%"></span></span>
        <p class="progress-line__note">
          <% if (player.nextHealthIn === null) { %>Combat ready.<% } else { %>+1 in <span data-countdown="health"><%= player.nextHealthIn %>s</span> · 1 per <%= player.healthRegenSeconds / 60 %> min<% } %>
        </p>
      </div>
      <% if (player.hospitalized) { %>
        <div class="hospital hospital--admitted">
          <div>
            <p class="hospital__title">Admitted to hospital</p>
            <p class="hospital__note">Released in <span data-until="<%= player.hospitalUntil %>" data-reload>soon</span></p>
          </div>
          <a class="btn btn--primary btn--sm" href="/hospital">Ward</a>
        </div>
      <% } else { %>
        <form method="post" action="/hospital" class="hospital">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div>
            <p class="hospital__title">Field hospital</p>
            <p class="hospital__note"><%= player.hospitalCost ? `Full treatment: $${player.hospitalCost}` : 'No treatment needed.' %></p>
          </div>
          <button class="btn btn--ghost btn--sm" type="submit" <%- player.hospitalCost === 0 || player.hospitalCost > player.cash ? 'disabled' : '' %>>Treat</button>
        </form>
      <% } %>
    </section>

    <section class="card hq-card hq-card--log reveal" style="--i:6" aria-labelledby="log-title">
      <h2 id="log-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-radio"/></svg>Radio log</h2>
      <% if (activity.length) { %>
        <ol class="dossier__log">
          <% activity.forEach(function (a) { %>
            <li class="log log--<%= a.kind %>"><time class="log__time" datetime="<%= new Date(a.created_at).toISOString() %>"><%= fmtTime(a.created_at) %></time> <%= a.message %><% if (a.link) { %> <a class="log__link" href="<%= a.link %>">Report</a><% } %></li>
          <% }) %>
        </ol>
      <% } else { %>
        <p class="muted">Radio silence. Run a mission to get chatter going.</p>
      <% } %>
    </section>
    <section class="card hq-card hq-card--feed reveal" style="--i:7" aria-labelledby="feed-title">
      <h2 id="feed-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-target"/></svg>Combat feed <a class="card__title-link" href="/leaderboards?board=pvp">Leaderboards</a></h2>
      <% if (feed.length) { %>
        <ol class="feed">
          <% feed.forEach(function (b) {
               const winner = b.attacker_won ? b.attacker_name : b.defender_name;
               const loser = b.attacker_won ? b.defender_name : b.attacker_name; %>
            <li>
              <a class="feed__row" href="/battles/<%= b.id %>">
                <span class="feed__text">
                  <% if (b.attacker_won) { %>
                    <strong><%= b.attacker_name %></strong> <%= b.knockout ? 'knocked out' : 'beat' %> <strong><%= b.defender_name %></strong><%= b.cash_taken ? ` and took $${b.cash_taken}` : '' %>
                  <% } else { %>
                    <strong><%= b.defender_name %></strong> <%= b.knockout ? 'knocked out' : 'held off' %> <strong><%= b.attacker_name %></strong>
                  <% } %>
                </span>
                <span class="feed__time"><%= b.ago %></span>
              </a>
            </li>
          <% }) %>
        </ol>
      <% } else { %>
        <p class="muted">No fights yet. Someone has to throw the first punch. <a href="/players?filter=targets">Find a target</a>.</p>
      <% } %>
    </section>
  </div>
</main>

<%- include('partials/foot') %>
