<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>

<main id="main" class="container game-main">
  <div class="page-head reveal" style="--i:0">
    <div>
      <p class="eyebrow">Medical corps</p>
      <h1 class="page-head__title">Field hospital</h1>
      <p class="page-head__sub">Knocked-out soldiers are admitted for 10 minutes and leave with at least half their health. Patients can't run missions, attack or be attacked.</p>
    </div>
  </div>

  <div class="hospital-grid">
    <section class="card reveal" style="--i:1" aria-labelledby="you-title">
      <h2 id="you-title" class="card__title">Your status</h2>
      <% if (player.hospitalized) { %>
        <p class="ward-status ward-status--admitted"><svg aria-hidden="true"><use href="#i-health"/></svg>Admitted</p>
        <p class="ward-reason"><%= player.hospitalReason %></p>
        <p class="ward-timer">Released in <strong data-until="<%= player.hospitalUntil %>" data-reload>soon</strong></p>
        <form method="post" action="/hospital/discharge" class="hospital">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div>
            <p class="hospital__title">Early discharge</p>
            <p class="hospital__note">$<%= player.dischargeCost.toLocaleString('en-US') %> · leave now with half health</p>
          </div>
          <button class="btn btn--primary btn--sm" type="submit" <%- player.dischargeCost > player.cash ? 'disabled' : '' %>>Pay</button>
        </form>
      <% } else { %>
        <p class="ward-status"><svg aria-hidden="true"><use href="#i-health"/></svg>Fit for duty</p>
        <div class="progress-line">
          <div class="progress-line__label"><span>Health</span><span><%= player.health %> / <%= player.maxHealth %></span></div>
          <span class="meter meter--health meter--lg"><span class="meter__fill" style="width:<%= player.healthPct %>%"></span></span>
        </div>
        <form method="post" action="/hospital" class="hospital">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div>
            <p class="hospital__title">Treatment</p>
            <p class="hospital__note"><%= player.hospitalCost ? `Full treatment: $${player.hospitalCost}` : 'No treatment needed.' %></p>
          </div>
          <button class="btn btn--ghost btn--sm" type="submit" <%- player.hospitalCost === 0 || player.hospitalCost > player.cash ? 'disabled' : '' %>>Treat</button>
        </form>
      <% } %>
    </section>

    <section class="card reveal" style="--i:2" aria-labelledby="ward-title">
      <h2 id="ward-title" class="card__title">On the ward <span class="count-pill"><%= patients.length %></span></h2>
      <% if (patients.length) { %>
        <ol class="ward">
          <% patients.forEach(function (p) { %>
            <li>
              <a class="ward__row<%= p.isYou ? ' ward__row--you' : '' %>" href="/profile/<%= encodeURIComponent(p.username) %>">
                <span class="stat__grade"><%= p.grade %></span>
                <span class="ward__who">
                  <span class="roster__name"><%= p.username %><% if (p.isYou) { %> <span class="tag">You</span><% } %></span>
                  <span class="ward__reason"><%= p.reason %></span>
                </span>
                <span class="ward__time" data-until="<%= p.until %>"><%= p.minutesLeft %>m</span>
              </a>
            </li>
          <% }) %>
        </ol>
      <% } else { %>
        <p class="muted">Every bed is empty. It won't last.</p>
      <% } %>
    </section>
  </div>
</main>

<%- include('partials/foot') %>
