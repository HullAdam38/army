<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>
<% const icons = { 'attacked-lost': 'i-target', 'attacked-won': 'i-crest', promotion: 'i-chevrons', unlock: 'i-star', system: 'i-radio', order: 'i-star', unit: 'i-flag', war: 'i-target', medal: 'i-star', bounty: 'i-cash', tutorial: 'i-chevrons', event: 'i-star', base: 'i-crest', deployment: 'i-kit', season: 'i-podium', chat: 'i-chat', title: 'i-star' }; %>

<main id="main" class="container game-main">
  <div class="page-head reveal" style="--i:0">
    <div>
      <p class="eyebrow">Signals</p>
      <h1 class="page-head__title">Notifications</h1>
      <p class="page-head__sub">Attacks on you, chat mentions, promotions, new unlocks and completed daily orders. While the game is open you'll also get a pop-up as they happen.</p>
    </div>
  </div>

  <a class="card alerts-link reveal" style="--i:1" href="/account/alerts">
    <svg aria-hidden="true"><use href="#i-bell"/></svg>
    <span><strong>App &amp; alerts</strong><span class="muted">Install the app and get alerts on your phone, even with the game closed.</span></span>
    <svg class="alerts-link__arrow" aria-hidden="true"><use href="#i-arrow"/></svg>
  </a>

  <% if (items.length) { %>
    <ol class="notes reveal" style="--i:1">
      <% items.forEach(function (n) { %>
        <li class="note note--<%= n.kind %><%= n.read_at ? '' : ' note--unread' %>">
          <svg class="note__icon" aria-hidden="true"><use href="#<%= icons[n.kind] || 'i-radio' %>"/></svg>
          <div class="note__body">
            <p class="note__msg"><% if (!n.read_at) { %><span class="visually-hidden">New: </span><% } %><%= n.message %></p>
            <p class="note__meta"><time datetime="<%= new Date(n.created_at).toISOString() %>"><%= n.ago %></time><% if (n.link) { %> · <a href="<%= n.link %>"><%= n.link.startsWith('/battles') ? 'View battle report' : 'Take a look' %></a><% } %></p>
          </div>
        </li>
      <% }) %>
    </ol>
  <% } else { %>
    <p class="card muted">Nothing yet. Quiet on the front.</p>
  <% } %>
</main>

<%- include('partials/foot') %>
