<%- include('partials/head', { bodyClass: 'page-auth' }) %>
<%- include('partials/header') %>
<%
  const attrs = (n) => errors[n] ? `aria-invalid="true" aria-describedby="${n}-error"` : '';
  const err = (n) => errors[n] ? `<p class="field__error" id="${n}-error">${errors[n]}</p>` : '';
%>

<main id="main" class="auth">
  <div class="auth__panel reveal" style="--i:0">
    <div class="form-card">
      <div class="form-card__head"><span>Form EF-7</span><span>Credentials</span></div>
      <h1 class="form-card__title"><%= forced ? 'Set a new password' : 'Change password' %></h1>
      <p class="form-card__sub">
        <%= forced ? 'An admin reset your password. Enter the temporary password you were given, then choose your own to continue.' : 'Changing your password signs you out on every other device.' %>
      </p>
      <form method="post" action="/account/password" class="form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="current"><%= forced ? 'Temporary password' : 'Current password' %></label>
          <input id="current" name="current" type="password" autocomplete="current-password" required autofocus <%- attrs('current') %>>
          <%- err('current') %>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="password">New password</label>
            <div class="field__pw">
              <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" <%- attrs('password') %>>
              <button type="button" class="field__toggle" data-toggle-password="password" aria-label="Show password" aria-pressed="false">Show</button>
            </div>
            <%- err('password') %>
          </div>
          <div class="field">
            <label for="confirm">Confirm new password</label>
            <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="8" <%- attrs('confirm') %>>
            <%- err('confirm') %>
          </div>
        </div>
        <button class="btn btn--primary btn--block" type="submit">Save password</button>
      </form>
      <% if (!forced) { %><p class="form-card__alt"><a href="/hq">Back to HQ</a></p><% } %>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
