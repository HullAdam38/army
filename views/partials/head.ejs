<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
<%
  const pageTitle = title ? `${title} · ${siteName}` : `${siteName}: free military strategy game in your browser`;
  const pageDescription = locals.description || 'GeneralForces is a free text-based military strategy game you play in your browser. Run missions, fight other players, join a unit and climb from Recruit to General.';
%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">
  <% if (signedIn) { %><meta name="robots" content="noindex"><% } else { %><link rel="canonical" href="<%= siteUrl %><%= canonicalPath %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= siteUrl %><%= canonicalPath %>">
  <meta property="og:image" content="<%= siteUrl %>/img/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="GeneralForces: earn your stripes. A free military strategy game in your browser.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#0d100e">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="GeneralForces">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Chakra+Petch:wght@500;600;700&family=Saira+Stencil+One&display=swap">
  <link rel="stylesheet" href="/css/main.css?v=<%= assetVersion %>">
  <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip-link" href="#main">Skip to content</a>
<%- include('icons') %>
