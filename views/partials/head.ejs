<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · ${siteName}` : `${siteName} — Text-based military strategy` %></title>
  <meta name="description" content="EliteForces is a free text-based military strategy game. Enlist, run missions, earn promotions and climb from Recruit to General.">
  <meta name="theme-color" content="#0d100e">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Chakra+Petch:wght@500;600;700&family=Saira+Stencil+One&display=swap">
  <link rel="stylesheet" href="/css/main.css?v=<%= assetVersion %>">
  <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip-link" href="#main">Skip to content</a>
<%- include('icons') %>
