<%# The admin area's menu. Pass `active` (a key below). %>
<nav class="admin-nav" aria-label="Admin">
  <% [
    ['overview', '/admin', 'Overview'],
    ['launch', '/admin/launch', 'Launch checklist'],
    ['support', '/admin/support', 'Support'],
    ['stats', '/admin/stats', 'Player stats'],
    ['players', '/admin/players', 'Players'],
    ['units', '/admin/units', 'Units'],
    ['teamwork', '/admin/teamwork', 'Raids & map'],
    ['economy', '/admin/economy', 'Economy'],
    ['casino', '/admin/casino', 'Casino'],
    ['supporters', '/admin/supporters', 'Supporters'],
    ['updates', '/admin/updates', 'Patch notes'],
    ['audit', '/admin/audit', 'Audit log'],
    ['settings', '/admin/settings', 'Game settings'],
    ['server', '/admin/server', 'Server settings'],
    ['events', '/admin/events', 'Events'],
    ['reports', '/admin/reports', 'Messages'],
    ['chat', '/admin/chat', 'Chat'],
    ['avatars', '/admin/avatars', 'Avatars'],
    ['flags', '/admin/flags', 'Anti-cheat'],
  ].forEach(function ([key, href, label]) { %>
    <a class="admin-nav__link" href="<%= href %>" <%- active === key ? 'aria-current="page"' : '' %>><%= label %><% if (key === 'support' && typeof supportWaiting !== 'undefined' && supportWaiting) { %> <span class="admin-nav__count" aria-label="<%= supportWaiting %> waiting"><%= supportWaiting %></span><% } %></a>
  <% }) %>
</nav>
