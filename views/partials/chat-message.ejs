<%# One chat message. Used by the chat page and by live updates (rendered server-side). %>
<% const at = new Date(m.created_at); %>
<% if (m.kind) { %>
<li class="chat-msg chat-msg--shout chat-msg--<%= m.kind === 'casino' ? 'casino' : 'news' %>" id="m-<%= m.id %>" data-id="<%= m.id %>">
  <div class="chat-shout">
    <svg class="chat-shout__icon" aria-hidden="true"><use href="#<%= m.kind === 'casino' ? 'i-star' : 'i-radio' %>"/></svg>
    <span class="chat-shout__text bb-content"><%- m.html %></span>
    <% if (m.kind === 'casino') { %><a class="chat-shout__go" href="/casino">Casino</a><% } %>
    <time class="chat-msg__time" datetime="<%= at.toISOString() %>" data-local-time title="<%= at.toISOString().slice(0, 16).replace('T', ' ') %> UTC"><%= at.toISOString().slice(11, 16) %></time>
  </div>
  <% if (m.mine || isAdmin) { %>
    <details class="chat-msg__menu">
      <summary aria-label="Message options"><span aria-hidden="true">⋯</span></summary>
      <div class="chat-menu">
        <form method="post" action="/chat/messages/<%= m.id %>/delete" data-chat-delete>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="chat-menu__item" type="submit">Delete announcement</button>
        </form>
      </div>
    </details>
  <% } %>
</li>
<% } else { %>
<li class="chat-msg<%= m.mine ? ' chat-msg--mine' : '' %><%= m.mentionsMe ? ' chat-msg--mention' : '' %><%= m.is_admin ? ' chat-msg--admin' : '' %>" id="m-<%= m.id %>" data-id="<%= m.id %>">
  <a class="chat-msg__avatar" href="/profile/<%= encodeURIComponent(m.username) %>" tabindex="-1" aria-hidden="true"><%- include('avatar', { url: m.avatarUrl, size: 'xs' }) %></a>
  <div class="chat-msg__head">
    <a class="chat-msg__name" href="/profile/<%= encodeURIComponent(m.username) %>" style="<%= nameStyle(m.name_color) %>"><% if (m.unit_tag) { %><span class="unit-tag">[<%= m.unit_tag %>]</span> <% } %><%= m.username %></a>
    <% if (m.titleName) { %><span class="callsign-title chat-msg__title"><%= m.titleName %></span><% } %>
    <% if (m.is_admin) { %><span class="tag tag--admin">Admin</span><% } %>
    <% if (m.supporter) { %><span class="tag tag--supporter" title="Supports the game">Supporter</span><% } %>
    <span class="chat-msg__lvl">Lv <%= m.level %></span>
    <time class="chat-msg__time" datetime="<%= at.toISOString() %>" data-local-time title="<%= at.toISOString().slice(0, 16).replace('T', ' ') %> UTC"><%= at.toISOString().slice(11, 16) %></time>
    <details class="chat-msg__menu">
      <summary aria-label="Message options"><span aria-hidden="true">⋯</span></summary>
      <div class="chat-menu">
        <% if (m.mine || isAdmin) { %>
          <form method="post" action="/chat/messages/<%= m.id %>/delete" data-chat-delete>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="chat-menu__item" type="submit">Delete message</button>
          </form>
        <% } %>
        <% if (!m.mine) { %>
          <form method="post" action="/chat/messages/<%= m.id %>/report" class="chat-menu__form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="visually-hidden" for="why-<%= m.id %>">Reason for reporting</label>
            <input id="why-<%= m.id %>" name="reason" maxlength="200" placeholder="Why? (optional)">
            <button class="chat-menu__item chat-menu__item--warn" type="submit">Report to admins</button>
          </form>
        <% } %>
        <% if (isAdmin && !m.mine) { %>
          <form method="post" action="/chat/messages/<%= m.id %>/mute" class="chat-menu__form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="visually-hidden" for="mute-<%= m.id %>">Mute for</label>
            <select id="mute-<%= m.id %>" name="duration">
              <% Object.entries(mutes).forEach(function ([key, v]) { %><option value="<%= key %>"><%= v.label %></option><% }) %>
            </select>
            <label class="visually-hidden" for="mute-why-<%= m.id %>">Mute reason</label>
            <input id="mute-why-<%= m.id %>" name="reason" maxlength="120" placeholder="Reason (shown to them)">
            <label class="chat-menu__check"><input type="checkbox" name="delete" value="1" checked> Delete this message</label>
            <button class="chat-menu__item chat-menu__item--admin" type="submit">Admin: mute <%= m.username %></button>
          </form>
        <% } %>
      </div>
    </details>
  </div>
  <div class="chat-msg__body bb-content"><%- m.html %></div>
</li>
<% } %>
