<header class="site-header<%= player ? ' site-header--game' : '' %>">
  <div class="container site-header__bar">
    <a class="brand" href="<%= signedIn ? '/hq' : '/' %>" aria-label="EliteForces home">
      <svg class="brand__crest" aria-hidden="true"><use href="#i-crest"/></svg>
      <span>Elite<b>Forces</b></span>
    </a>
    <% if (player) { %>
      <nav class="game-nav" aria-label="Game">
        <a href="/hq" class="game-nav__link" <%- nav === 'hq' ? 'aria-current="page"' : '' %>>HQ</a>
        <a href="/missions" class="game-nav__link" <%- nav === 'missions' ? 'aria-current="page"' : '' %>>Missions</a>
        <a href="/armory" class="game-nav__link" <%- nav === 'armory' ? 'aria-current="page"' : '' %>>Armory</a>
        <a href="/hospital" class="game-nav__link" <%- nav === 'hospital' ? 'aria-current="page"' : '' %>>Hospital</a>
        <a href="/players" class="game-nav__link" <%- nav === 'players' || nav === 'online' ? 'aria-current="page"' : '' %>>Players</a>
        <a href="/profile/<%= encodeURIComponent(player.username) %>" class="game-nav__link" <%- nav === 'profile' ? 'aria-current="page"' : '' %>>Profile</a>
      </nav>
      <form method="post" action="/logout" class="site-header__logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost btn--sm" type="submit">Sign out</button>
      </form>
    <% } else if (signedIn) { %>
      <nav class="site-header__actions" aria-label="Account">
        <a class="btn btn--primary btn--sm" href="/hq">Return to HQ</a>
      </nav>
    <% } else { %>
      <nav class="site-header__actions" aria-label="Account">
        <a class="btn btn--ghost btn--sm" href="/login">Sign in</a>
        <a class="btn btn--primary btn--sm" href="/register">Enlist</a>
      </nav>
    <% } %>
  </div>
  <% if (player) { %><%- include('statbar') %><% } %>
  <% if (player && player.hospitalized) { %>
    <div class="ward-banner" role="status">
      <div class="container ward-banner__inner">
        <svg aria-hidden="true"><use href="#i-health"/></svg>
        <span>You're in hospital. Released in <strong data-until="<%= player.hospitalUntil %>" data-reload>soon</strong>. Missions and PvP are unavailable.</span>
        <a href="/hospital">Hospital</a>
      </div>
    </div>
  <% } %>
</header>
<% if (flash.length) { %>
  <div class="container flash-stack" role="status">
    <% flash.forEach(function (f) { %>
      <p class="flash flash--<%= f.type %>"><%= f.message %></p>
    <% }) %>
  </div>
<% } %>
