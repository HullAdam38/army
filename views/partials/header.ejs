<header class="site-header<%= player ? ' site-header--game' : '' %><%= player && isAdmin ? ' site-header--admin' : '' %>">
  <div class="container site-header__bar">
    <a class="brand" href="<%= signedIn ? '/hq' : '/' %>" aria-label="GeneralForces home">
      <svg class="brand__crest" aria-hidden="true"><use href="#i-crest"/></svg>
      <span>General<b>Forces</b></span>
    </a>
    <% if (player) { %>
      <nav class="game-nav" aria-label="Game">
        <a href="/hq" class="game-nav__link" <%- nav === 'hq' ? 'aria-current="page"' : '' %>>HQ</a>
        <a href="/missions" class="game-nav__link" <%- nav === 'missions' ? 'aria-current="page"' : '' %>>Missions</a>
        <a href="/armory" class="game-nav__link" <%- nav === 'armory' ? 'aria-current="page"' : '' %>>Armory</a>
        <a href="/training" class="game-nav__link" <%- nav === 'training' ? 'aria-current="page"' : '' %>>Training</a>
        <a href="/bank" class="game-nav__link" <%- nav === 'bank' ? 'aria-current="page"' : '' %>>Bank</a>
        <a href="/hospital" class="game-nav__link" <%- nav === 'hospital' ? 'aria-current="page"' : '' %>>Hospital</a>
        <a href="/unit" class="game-nav__link" <%- nav === 'unit' ? 'aria-current="page"' : '' %>>Unit</a>
        <a href="/players" class="game-nav__link" <%- nav === 'players' || nav === 'online' ? 'aria-current="page"' : '' %>>Players</a>
        <a href="/profile/<%= encodeURIComponent(player.username) %>" class="game-nav__link" <%- nav === 'profile' ? 'aria-current="page"' : '' %>>Profile</a>
        <% if (isAdmin) { %><a href="/admin" class="game-nav__link game-nav__link--admin" <%- nav === 'admin' ? 'aria-current="page"' : '' %>>Admin</a><% } %>
      </nav>
      <% const cu = chatUnread || { unit: 0, global: false }; %>
      <a class="bell bell--chat" href="<%= cu.unit ? '/chat/unit' : '/chat' %>" data-chat-bell
         aria-label="Chat<%= cu.unit ? `, ${cu.unit} new in your unit channel` : cu.global ? ', new messages' : '' %>" <%- nav === 'chat' ? 'aria-current="page"' : '' %>>
        <svg aria-hidden="true"><use href="#i-chat"/></svg>
        <span class="bell__count" data-chat-count <%- cu.unit ? '' : 'hidden' %>><%= cu.unit > 99 ? '99+' : cu.unit %></span>
        <span class="bell__dot" data-chat-dot <%- !cu.unit && cu.global ? '' : 'hidden' %>></span>
      </a>
      <a class="bell bell--mail" href="/messages" data-mail data-count="<%= unreadMessages %>"
         aria-label="Messages<%= unreadMessages ? `, ${unreadMessages} unread` : '' %>" <%- nav === 'messages' ? 'aria-current="page"' : '' %>>
        <svg aria-hidden="true"><use href="#i-mail"/></svg>
        <span class="bell__count" data-mail-count <%- unreadMessages ? '' : 'hidden' %>><%= unreadMessages > 99 ? '99+' : unreadMessages %></span>
      </a>
      <a class="bell" href="/notifications" data-bell data-latest-id="<%= latestNotificationId %>"
         aria-label="Notifications<%= unreadCount ? `, ${unreadCount} unread` : '' %>" <%- nav === 'notifications' ? 'aria-current="page"' : '' %>>
        <svg aria-hidden="true"><use href="#i-bell"/></svg>
        <span class="bell__count" data-bell-count <%- unreadCount ? '' : 'hidden' %>><%= unreadCount > 99 ? '99+' : unreadCount %></span>
      </a>
      <form method="post" action="/logout" class="site-header__logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost btn--sm" type="submit">Sign out</button>
      </form>
    <% } else if (signedIn) { %>
      <nav class="site-header__actions" aria-label="Account">
        <a class="btn btn--primary btn--sm" href="/hq">Return to HQ</a>
      </nav>
    <% } else { %>
      <nav class="site-header__actions" aria-label="Account">
        <a class="btn btn--ghost btn--sm" href="/login">Sign in</a>
        <a class="btn btn--primary btn--sm" href="/register">Enlist</a>
      </nav>
    <% } %>
  </div>
  <% if (player) { %><%- include('statbar') %><% } %>
  <% if (player && liveEvents.length) { %>
    <div class="event-banner" role="status">
      <div class="container event-banner__inner">
        <% liveEvents.forEach(function (e) { %>
          <a class="event-banner__item" href="/events">
            <svg aria-hidden="true"><use href="#<%= e.def.icon %>"/></svg>
            <span><strong><%= e.title %></strong> is live: <%= e.def.summary %></span>
            <span class="event-banner__time">Ends in <span data-until="<%= e.ends_at %>">soon</span></span>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
  <% if (player && player.hospitalized) { %>
    <div class="ward-banner" role="status">
      <div class="container ward-banner__inner">
        <svg aria-hidden="true"><use href="#i-health"/></svg>
        <span>You're in hospital. Released in <strong data-until="<%= player.hospitalUntil %>" data-reload>soon</strong>. Missions and PvP are unavailable.</span>
        <a href="/hospital">Hospital</a>
      </div>
    </div>
  <% } %>
  <% if (player && player.deployed) { %>
    <div class="ward-banner deploy-banner" role="status">
      <div class="container ward-banner__inner">
        <svg aria-hidden="true"><use href="#i-kit"/></svg>
        <span>You're on deployment. Back in <strong data-until="<%= player.deployedUntil %>" data-reload>soon</strong>. Missions, training and PvP wait until you return.</span>
        <a href="/deployments">Deployments</a>
      </div>
    </div>
  <% } %>
</header>
<% if (player) { %><%- include('tabbar') %><% } %>
<% if (player) { %><div class="toasts" data-toasts aria-live="polite"></div><% } %>
<% if (flash.length) { %>
  <div class="container flash-stack" role="status">
    <% flash.forEach(function (f) { %>
      <p class="flash flash--<%= f.type %>"><%= f.message %></p>
    <% }) %>
  </div>
<% } %>
