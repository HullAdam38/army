<%# Combat profile + loadout. Expects `loadout`; `editable` shows stow buttons. %>
<% const st = loadout.stats; const icons = { weapon: 'i-weapon', body: 'i-body', helmet: 'i-helmet', kit: 'i-kit' }; %>
<div class="combat-profile">
  <div class="combat-profile__rating">
    <span class="combat-profile__label">Combat rating</span>
    <span class="combat-profile__value"><%= loadout.rating %></span>
  </div>
  <dl class="combat-stats">
    <div><dt>Attack</dt><dd><%= Math.round(st.attack) %></dd></div>
    <div><dt>Damage</dt><dd>×<%= st.damage.toFixed(2) %></dd></div>
    <div><dt>Crit chance</dt><dd><%= Math.round(st.critChance * 100) %>%</dd></div>
    <div><dt>Crit damage</dt><dd>×<%= st.critDamage.toFixed(2) %></dd></div>
    <div><dt>Armour</dt><dd><%= Math.round(st.armor) %> <small>−<%= loadout.mitigationPct %>% dmg</small></dd></div>
    <div><dt>Mission bonus</dt><dd>+<%= loadout.gearBonusPct %>%</dd></div>
  </dl>
</div>
<ul class="loadout">
  <% loadout.slots.forEach(function (s) { %>
    <li class="loadout__slot<%= s.item ? '' : ' loadout__slot--empty' %>">
      <svg class="loadout__icon" aria-hidden="true"><use href="#<%= icons[s.id] %>"/></svg>
      <span class="loadout__body">
        <span class="loadout__label"><%= s.label %></span>
        <span class="loadout__name"><%= s.item ? s.item.name : 'Empty' %></span>
        <% if (s.item) { %><span class="loadout__mods"><%= s.mods.join(' · ') %></span><% } %>
      </span>
      <% if (typeof editable !== 'undefined' && editable && s.item) { %>
        <form method="post" action="/armory/unequip/<%= s.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit" aria-label="Stow <%= s.item.name %>">Stow</button>
        </form>
      <% } %>
    </li>
  <% }) %>
</ul>
