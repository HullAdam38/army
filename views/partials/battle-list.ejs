<%# Expects `battles` (rows from battlesFor) and `perspective` (username whose point of view to use). %>
<% if (battles.length) { %>
  <ol class="battle-list">
    <% battles.forEach(function (b) {
         const asAttacker = b.attacker_name === perspective;
         const won = asAttacker ? b.attacker_won : !b.attacker_won;
         const other = asAttacker ? b.defender_name : b.attacker_name;
         const otherId = asAttacker ? b.defender_id : b.attacker_id;
         const otherV = asAttacker ? b.defender_avatar_v : b.attacker_avatar_v; %>
      <li>
        <a class="battle-row battle-row--<%= won ? 'win' : 'loss' %>" href="/battles/<%= b.id %>">
          <span class="battle-row__result"><%= won ? 'Won' : 'Lost' %></span>
          <%- include('avatar', { url: avatarUrl(otherId, otherV), size: 'xs', extra: 'battle-row__avatar' }) %>
          <span class="battle-row__text"><%= asAttacker ? 'Attacked' : 'Defended against' %> <strong><%= other %></strong><%= b.knockout ? ' · KO' : '' %><%= b.cash_taken ? ` · $${b.cash_taken}` : '' %></span>
          <span class="battle-row__time"><%= b.ago %></span>
        </a>
      </li>
    <% }) %>
  </ol>
<% } else { %>
  <p class="muted">No battles yet.</p>
<% } %>
