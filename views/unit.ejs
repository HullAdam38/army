<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>
<%
  const money = (n) => '$' + Number(n).toLocaleString('en-US');
  const member = Boolean(role);
  const csrf = `<input type="hidden" name="_csrf" value="${csrfToken}">`;
  const others = roster.filter((m) => !m.isYou && !m.banned_at);
%>

<main id="main" class="container game-main">
  <a class="back-link reveal" style="--i:0" href="/units"><svg aria-hidden="true"><use href="#i-arrow"/></svg>All units</a>

  <section class="card unit-hero reveal" style="--i:1" aria-labelledby="unit-name">
    <span class="unit-crest unit-crest--xl" aria-hidden="true"><%= unit.tag %></span>
    <div class="unit-hero__body">
      <p class="eyebrow">Unit profile · ranked #<%= unit.position %> · founded <time datetime="<%= stats.foundedIso %>"><%= stats.founded %></time></p>
      <h1 id="unit-name" class="profile-hero__name"><%= unit.name %> <span class="unit-tag">[<%= unit.tag %>]</span></h1>
      <% if (unit.description) { %><div class="unit-hero__desc bb-content"><%- unit.descriptionHtml %></div><% } %>
      <p class="unit-hero__leader">Commander <% const lead = roster.find((m) => m.unit_role === 'leader'); %><% if (lead) { %><a href="/profile/<%= encodeURIComponent(lead.username) %>"><%= lead.username %></a><% } else { %>—<% } %></p>
      <dl class="figures unit-hero__figures">
        <div><dt>Strength</dt><dd><%= unit.strength %></dd></div>
        <div><dt>Members</dt><dd><%= members %> / <%= unit.capacity %></dd></div>
        <div><dt>War record</dt><dd title="Wins–losses–draws"><%= stats.record.wins %>–<%= stats.record.losses %>–<%= stats.record.draws %></dd></div>
        <div><dt>PvP wins</dt><dd><%= stats.pvpWins.toLocaleString('en-US') %></dd></div>
        <div><dt>Missions won</dt><dd><%= stats.missions.toLocaleString('en-US') %></dd></div>
        <div><dt>Mission XP</dt><dd><%= unit.xpBonusPct ? `+${unit.xpBonusPct}%` : '—' %></dd></div>
      </dl>
      <div class="unit-recruit">
        <span class="unit-recruit__label">Applications</span>
        <% if (!unit.recruiting) { %><span class="status"><span class="status-dot status-dot--off" aria-hidden="true"></span>Closed</span>
        <% } else if (members >= unit.capacity) { %><span class="status"><span class="status-dot status-dot--off" aria-hidden="true"></span>Full</span>
        <% } else { %><span class="status status--online"><span class="status-dot" aria-hidden="true"></span>Open</span><% } %>
        <% if (requirements.length) { %>
          <span class="unit-recruit__label">Requires</span>
          <% requirements.forEach(function (r) { %><span class="req-chip"><%= r.text %></span><% }) %>
        <% } else if (unit.recruiting) { %><span class="muted">No requirements</span><% } %>
      </div>
    </div>
    <div class="unit-hero__action">
      <% if (member) { %>
        <p class="unit-hero__role">You are <strong><%= roleLabel %></strong></p>
        <form method="post" action="/units/<%= unit.id %>/leave" data-confirm="<%= role === 'leader' ? (members > 1 ? 'Hand command to someone first.' : 'You are the last member, so leaving disbands the unit and its treasury is lost. Continue?') : `Leave ${unit.name}?` %>">
          <%- csrf %>
          <button class="btn btn--ghost btn--sm" type="submit"><%= role === 'leader' && members <= 1 ? 'Disband & leave' : 'Leave unit' %></button>
        </form>
      <% } else if (apply.applied) { %>
        <p class="unit-hero__role">Application sent. Officers will review it.</p>
        <form method="post" action="/units/<%= unit.id %>/withdraw"><%- csrf %><button class="btn btn--ghost btn--sm" type="submit">Withdraw</button></form>
      <% } else if (apply.blocker) { %>
        <p class="unit-hero__role muted"><%= apply.blocker %></p>
      <% } else { %>
        <p class="unit-hero__role">You meet their requirements.</p>
        <form method="post" action="/units/<%= unit.id %>/apply" class="unit-apply" id="apply">
          <%- csrf %>
          <%- include('partials/bb-editor', { id: 'apply-msg', name: 'message', label: 'Message to the officers', max: limits.message, rows: 3, required: false, compact: true, placeholder: 'Why should they take you? (optional)' }) %>
          <button class="btn btn--primary btn--block" type="submit"><svg class="btn__icon" aria-hidden="true"><use href="#i-flag"/></svg>Apply to join</button>
        </form>
      <% } %>
      <% if (declare && !war) { %>
        <div class="unit-declare">
          <% if (declare.blocker) { %>
            <p class="unit-hero__role muted">War: <%= declare.blocker %></p>
          <% } else { %>
            <form method="post" action="/units/<%= unit.id %>/war" data-confirm="Declare war on <%= unit.name %>? <%= money(declare.stake) %> comes out of the <%= declare.from.name %> treasury. The war lasts 24 hours.">
              <%- csrf %>
              <button class="btn btn--danger btn--block" type="submit"><svg class="btn__icon" aria-hidden="true"><use href="#i-target"/></svg>Declare war · <%= money(declare.stake) %></button>
            </form>
            <p class="progress-line__note">Paid from the [<%= declare.from.tag %>] treasury. Win the war to get double back.</p>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <% if (war) { %>
    <section class="war-banner reveal" style="--i:2" aria-label="Active war">
      <svg class="war-banner__icon" aria-hidden="true"><use href="#i-target"/></svg>
      <div class="war-banner__text">
        <p class="war-banner__title">At war with <a href="/units/<%= war.them.id %>">[<%= war.them.tag %>] <%= war.them.name %></a></p>
        <p class="war-banner__meta">Ends in <span data-until="<%= war.ends_at %>" data-reload>soon</span><%= war.us === 'attacker' ? ' · we declared' : ' · they declared' %></p>
      </div>
      <p class="war-banner__score" aria-label="Score <%= war.ourScore %> to <%= war.theirScore %>"><span class="<%= war.ourScore >= war.theirScore ? 'is-ahead' : '' %>"><%= war.ourScore %></span><small>–</small><span class="<%= war.theirScore > war.ourScore ? 'is-ahead' : '' %>"><%= war.theirScore %></span></p>
      <div class="war-banner__actions">
        <a class="btn btn--ghost btn--sm" href="/wars/<%= war.id %>">War room</a>
        <% if (member) { %><a class="btn btn--primary btn--sm" href="/players?filter=war">Find targets</a><% } %>
      </div>
    </section>
  <% } %>

  <% if (member) { %>
    <section id="rally" class="card unit-rally reveal<%= rally.active ? ' is-active' : '' %>" style="--i:2" aria-labelledby="rally-title">
      <div class="unit-rally__body">
        <h2 id="rally-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-flag"/></svg>Rally order: <%= rally.label %></h2>
        <% if (rally.active) { %>
          <p class="unit-rally__live"><strong>Rally under way.</strong> Every member gets +<%= rally.pct %>% mission and operation cash and XP for <span data-until="<%= rally.active %>">the next hour</span>.</p>
        <% } else { %>
          <p class="muted">A Lieutenant or the Commander can spend <strong><%= money(rally.cost) %></strong> from the treasury to give every member +<%= rally.pct %>% mission and operation cash and XP for an hour. Members get an alert. One rally every 12 hours.</p>
        <% } %>
      </div>
      <% if (!rally.active) { %>
        <div class="unit-rally__action">
          <% if (rally.readyAt > Date.now()) { %>
            <p class="muted small">Next rally in <span data-until="<%= rally.readyAt %>">a while</span></p>
          <% } else if (rally.canCall) { %>
            <form method="post" action="/units/<%= unit.id %>/rally" data-confirm="Spend <%= money(rally.cost) %> from the treasury on a rally?"><%- csrf %><button class="btn btn--primary btn--sm" type="submit" <%- unit.treasury < rally.cost ? 'disabled' : '' %>>Call a rally · <%= money(rally.cost) %></button></form>
            <% if (unit.treasury < rally.cost) { %><p class="muted small">The treasury needs <%= money(rally.cost - unit.treasury) %> more.</p><% } %>
          <% } else { %>
            <p class="muted small">Ask a Lieutenant or the Commander to call one.</p>
          <% } %>
        </div>
      <% } %>
    </section>
  <% } %>

  <% if (raid) { %>
    <section id="raid" class="card unit-raid reveal<%= raid.raid ? ' is-active' : '' %>" style="--i:2" aria-labelledby="raid-title">
      <h2 id="raid-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-target"/></svg>Raid<% if (raid.raid) { %> <span class="card__title-meta">Ends in <span data-until="<%= raid.raid.ends_at %>">a while</span></span><% } %></h2>
      <% if (raid.raid) { const r = raid.raid; %>
        <div class="unit-raid__target">
          <div class="unit-raid__head">
            <span class="unit-raid__name"><%= r.name %></span>
            <span class="unit-raid__hp"><%= r.hp.toLocaleString('en-US') %> / <%= r.max_hp.toLocaleString('en-US') %> health</span>
          </div>
          <p class="muted small"><%= r.blurb %></p>
          <span class="meter meter--lg unit-raid__meter" role="progressbar" aria-label="Stronghold health" aria-valuemin="0" aria-valuemax="<%= r.max_hp %>" aria-valuenow="<%= r.hp %>"><span class="meter__fill" style="width:<%= r.pct %>%"></span></span>
          <p class="unit-raid__loot">Loot if it falls: <strong><%= money(r.cash_pool) %></strong> and <strong><%= r.xp_pool.toLocaleString('en-US') %> XP</strong>, shared by damage dealt. <%= Math.round(raidShare * 100) %>% of the cash goes to the treasury.</p>
        </div>
        <div class="unit-raid__strike">
          <% if (r.blocker) { %>
            <p class="muted small"><%= r.blocker %>.</p>
          <% } else { %>
            <form method="post" action="/units/<%= unit.id %>/raid/strike"><%- csrf %><button class="btn btn--primary" type="submit">Strike · <%= raid.energy %> energy</button></form>
          <% } %>
          <p class="muted small"><%= r.mine ? `Your damage: ${r.mine.damage.toLocaleString('en-US')} in ${r.mine.strikes} strike${r.mine.strikes === 1 ? '' : 's'}.` : 'You haven’t struck yet. Every strike counts towards your share.' %> Each strike costs a little health too.</p>
        </div>
        <% if (r.top.length) { %>
          <h3 class="unit-raid__sub">Top strikers <span class="muted small">(<%= r.strikers %> in total)</span></h3>
          <ol class="unit-raid__top">
            <% r.top.forEach(function (h) { %>
              <li>
                <%- include('partials/avatar', { url: avatarUrl(h.userId, h.avatarV), size: 'sm' }) %>
                <a class="unit-raid__who" href="/profile/<%= encodeURIComponent(h.username) %>"><%= h.username %></a>
                <span class="unit-raid__dmg"><%= h.damage.toLocaleString('en-US') %> <span class="muted">· <%= h.share %>%</span></span>
              </li>
            <% }) %>
          </ol>
        <% } %>
      <% } else { %>
        <p class="muted">Pick an enemy stronghold and strike it together. It has one shared health bar and your unit has 48 hours. Each strike costs <%= raid.energy %> energy. If it falls, the loot is shared by damage dealt, with <%= Math.round(raidShare * 100) %>% going to the treasury. If time runs out, there’s no loot and the supplies are lost.</p>
        <% if (raid.last) { %>
          <p class="unit-raid__last <%= raid.last.status === 'won' ? 'is-won' : 'is-failed' %>">Last raid: <%= raid.last.name %>, <%= { won: 'taken', failed: 'ran out of time', cancelled: 'called off by HQ' }[raid.last.status] %>.</p>
        <% } %>
        <% if (raid.readyAt) { %>
          <p class="muted small">The unit is regrouping after its last raid. The next one can launch in <span data-until="<%= raid.readyAt %>">a few hours</span>.</p>
        <% } else if (raid.canLaunch) { %>
          <form method="post" action="/units/<%= unit.id %>/raid" class="unit-raid__launch" data-confirm="Spend treasury on supplies and launch this raid?">
            <%- csrf %>
            <fieldset>
              <legend class="unit-raid__sub">Choose a stronghold</legend>
              <% raid.options.forEach(function (s, i) { %>
                <label class="raid-option<%= s.affordable ? '' : ' is-locked' %>">
                  <input type="radio" name="stronghold" value="<%= s.id %>" <%- s.affordable ? '' : 'disabled' %> <%- s.affordable && i === raid.options.filter(function (o) { return o.affordable; }).length - 1 ? 'checked' : '' %> required>
                  <span class="raid-option__body">
                    <span class="raid-option__name"><%= s.name %></span>
                    <span class="raid-option__meta"><%= s.hp.toLocaleString('en-US') %> health · loot <%= money(s.cash) %> + <%= s.xp.toLocaleString('en-US') %> XP</span>
                    <span class="raid-option__cost">Supplies: <%= money(s.cost) %><%= s.affordable ? '' : ' (not enough in the treasury)' %></span>
                  </span>
                </label>
              <% }) %>
            </fieldset>
            <button class="btn btn--primary" type="submit" <%- raid.options.some(function (o) { return o.affordable; }) ? '' : 'disabled' %>>Launch raid</button>
          </form>
        <% } else { %>
          <p class="muted small">Ask a Lieutenant or the Commander to launch one.</p>
        <% } %>
        <% if (raid.next) { %><p class="muted small">The <%= raid.next.name %> opens when the unit averages level <%= raid.next.minLevel %>.</p><% } %>
      <% } %>
    </section>
  <% } %>

  <% if (theatre) { %>
    <section id="theatre" class="card unit-theatre reveal" style="--i:2" aria-labelledby="theatre-title">
      <div class="unit-rally__body">
        <h2 id="theatre-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-grid"/></svg>Theatre of war</h2>
        <p class="muted"><% if (theatre.front) { %>Fighting for <strong class="unit-theatre__front"><%= theatre.front.name %></strong> this week: <%= theatre.points.toLocaleString('en-US') %> points so far.<% } else { %>No front this week, so members’ play isn’t scoring on the map.<% } %>
        <% if (theatre.held.length) { %>Holding <%= theatre.held.map(function (r) { return r.name; }).join(', ') %> (<%= money(theatre.income) %> a day<%= theatre.xpPct ? `, +${theatre.xpPct}% mission XP` : '' %>).<% } %></p>
      </div>
      <div class="unit-rally__action"><a class="btn btn--ghost btn--sm" href="/theatre">Open the map <svg class="btn__icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    </section>
  <% } %>

  <% if (objectives) { %>
    <section id="objectives" class="card unit-objectives reveal" style="--i:2" aria-labelledby="objectives-title">
      <h2 id="objectives-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-flag"/></svg>Weekly objectives <span class="card__title-meta">New objectives in <span data-until="<%= objectives.endsAt %>">soon</span></span></h2>
      <p class="muted unit-objectives__intro">Every member’s play counts. Each objective completed pays into the treasury, and gives everyone who helped <%= member ? `+${objectives.memberXpAt(player.level)} XP` : 'bonus XP' %>.</p>
      <ol class="unit-objectives__list">
        <% objectives.items.forEach(function (o) { %>
          <li class="objective<%= o.done ? ' is-done' : '' %>">
            <span class="objective__icon" aria-hidden="true"><svg><use href="#<%= o.done ? 'i-star' : o.icon %>"/></svg></span>
            <div class="objective__body">
              <div class="objective__head"><span class="objective__name"><%= o.name %></span><span class="objective__count"><%= o.progressLabel %></span></div>
              <p class="objective__text"><%= o.text %></p>
              <span class="meter meter--xp" role="progressbar" aria-label="<%= o.text %>" aria-valuemin="0" aria-valuemax="<%= o.target %>" aria-valuenow="<%= o.progress %>"><span class="meter__fill" style="width:<%= o.pct %>%"></span></span>
              <p class="objective__reward"><%= o.done ? 'Complete: ' : 'Reward: ' %><%= money(o.reward_cash) %> to the treasury</p>
            </div>
          </li>
        <% }) %>
      </ol>
      <% if (objectives.top.length) { %>
        <div class="unit-objectives__top">
          <p class="unit-objectives__top-title">Top contributors this week</p>
          <ol class="unit-objectives__people">
            <% objectives.top.forEach(function (c) { %>
              <li><%- include('partials/avatar', { url: avatarUrl(c.userId, c.avatarV), size: 'xs' }) %><a class="directory__name" href="/profile/<%= encodeURIComponent(c.username) %>"><%= c.username %></a><span class="muted"><%= c.sharePct %>%</span></li>
            <% }) %>
          </ol>
        </div>
      <% } %>
    </section>
  <% } %>

  <div class="unit-grid">
    <section id="roster" class="card unit-card unit-card--roster reveal" style="--i:2" aria-labelledby="roster-title">
      <h2 id="roster-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-crest"/></svg>Roster</h2>
      <ol class="unit-roster">
        <% roster.forEach(function (m) { %>
          <li class="unit-roster__row unit-roster__row--<%= m.unit_role %><%= m.isYou ? ' is-you' : '' %>">
            <%- include('partials/avatar', { url: m.avatarUrl, size: 'sm' }) %>
            <span class="roster__who">
              <span><a class="roster__name directory__name" href="/profile/<%= encodeURIComponent(m.username) %>"><%= m.username %></a><% if (m.isYou) { %> <span class="tag">You</span><% } %></span>
              <span class="roster__rank"><span class="unit-role unit-role--<%= m.unit_role %>"><%= m.roleLabel %></span> · Lv <%= m.level %><% if (member) { %> · donated <%= money(m.unit_donated) %><% } %></span>
            </span>
            <span class="unit-roster__seen">
              <% if (m.banned_at) { %><span class="status">Suspended</span>
              <% } else if (m.online) { %><span class="status status--online"><span class="status-dot" aria-hidden="true"></span>Online</span>
              <% } else { %><span class="status"><span class="status-dot status-dot--off" aria-hidden="true"></span><%= m.lastSeen %></span><% } %>
            </span>
            <% if (!m.isYou && (m.canPromote || m.canDemote || m.canKick)) { %>
              <span class="unit-roster__actions">
                <% if (m.canPromote) { %>
                  <form method="post" action="/units/<%= unit.id %>/members/<%= m.id %>/promote"><%- csrf %><button class="btn btn--ghost btn--xs" type="submit" title="Promote to <%= m.promoteTo %>">Promote</button></form>
                <% } %>
                <% if (m.canDemote) { %>
                  <form method="post" action="/units/<%= unit.id %>/members/<%= m.id %>/demote"><%- csrf %><button class="btn btn--ghost btn--xs" type="submit" title="Demote to <%= m.demoteTo %>">Demote</button></form>
                <% } %>
                <% if (m.canKick) { %>
                  <form method="post" action="/units/<%= unit.id %>/members/<%= m.id %>/kick" data-confirm="Remove <%= m.username %> from the unit?"><%- csrf %><button class="btn btn--ghost btn--xs btn--danger" type="submit">Remove</button></form>
                <% } %>
              </span>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </section>

    <div class="unit-side">
      <% if (can.review) { %>
        <section id="applications" class="card unit-card reveal" style="--i:3" aria-labelledby="applications-title">
          <h2 id="applications-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-flag"/></svg>Applications<% if (applications.length) { %> <span class="tag"><%= applications.length %></span><% } %></h2>
          <% if (applications.length) { %>
            <ol class="unit-apps-review">
              <% applications.forEach(function (a) { %>
                <li>
                  <p class="unit-apps-review__who"><%- include('partials/avatar', { url: avatarUrl(a.user_id, a.avatar_v), size: 'sm' }) %><span><a class="directory__name" href="/profile/<%= encodeURIComponent(a.username) %>"><strong><%= a.username %></strong></a> <span class="muted">· Lv <%= a.level %> · <%= a.missions_completed %> missions · <%= a.pvp_wins %> PvP wins · <%= a.ago %></span></span></p>
                  <% if (a.message) { %><div class="unit-quote bb-content"><%- a.html %></div><% } %>
                  <div class="unit-apps-review__actions">
                    <form method="post" action="/units/<%= unit.id %>/applications/<%= a.id %>/accept"><%- csrf %><button class="btn btn--primary btn--sm" type="submit" <%- members >= unit.capacity ? 'disabled' : '' %>>Accept</button></form>
                    <form method="post" action="/units/<%= unit.id %>/applications/<%= a.id %>/reject"><%- csrf %><button class="btn btn--ghost btn--sm" type="submit">Reject</button></form>
                  </div>
                </li>
              <% }) %>
            </ol>
            <% if (members >= unit.capacity) { %><p class="progress-line__note">The unit is full. Upgrade the Barracks to accept more.</p><% } %>
          <% } else { %>
            <p class="muted">No applications waiting.</p>
          <% } %>
          <p class="unit-recruits-link">
            <a class="btn btn--ghost btn--sm" href="/units/<%= unit.id %>/recruits"><svg class="btn__icon" aria-hidden="true"><use href="#i-radio"/></svg>Find recruits</a>
            <span class="muted small"><%= lookingCount === 1 ? '1 soldier is' : `${lookingCount} soldiers are` %> looking for a unit. Invite them yourselves.</span>
          </p>
        </section>
      <% } %>

      <% if (member) { %>
        <section id="treasury" class="card unit-card reveal" style="--i:4" aria-labelledby="treasury-title">
          <h2 id="treasury-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-cash"/></svg>Treasury</h2>
          <p class="unit-treasury"><%= money(unit.treasury) %></p>
          <p class="progress-line__note">Donations can only be spent on upgrades by the Commander. They can’t be withdrawn.</p>
          <form method="post" action="/units/<%= unit.id %>/donate" class="unit-donate" data-bank-form data-max="<%= player.cash %>">
            <%- csrf %>
            <label class="visually-hidden" for="donate-amount">Amount to donate</label>
            <div class="money-input">
              <span aria-hidden="true">$</span>
              <input id="donate-amount" name="amount" inputmode="numeric" autocomplete="off" placeholder="<%= limits.minDonation %>" required>
              <button class="money-input__all" type="button" data-fill-all>All</button>
            </div>
            <p class="bank-form__preview" data-preview aria-live="polite">Minimum <%= money(limits.minDonation) %>. You have <%= money(player.cash) %> on hand.</p>
            <button class="btn btn--ghost btn--block" type="submit" <%- player.cash < limits.minDonation ? 'disabled' : '' %>>Donate</button>
          </form>
          <ul class="unit-upgrades">
            <% upgrades.forEach(function (u) { %>
              <li class="unit-upgrade">
                <div class="unit-upgrade__head">
                  <span class="unit-upgrade__name"><%= u.label %></span>
                  <span class="unit-upgrade__level">Lv <%= u.level %> / <%= u.max %></span>
                </div>
                <span class="meter meter--xp" aria-hidden="true"><span class="meter__fill" style="width:<%= Math.round(u.level / u.max * 100) %>%"></span></span>
                <p class="daily__reward"><%= u.blurb %> Now: <%= u.now %>.</p>
                <% if (!u.next) { %>
                  <p class="daily__status">Fully upgraded</p>
                <% } else if (can.manage) { %>
                  <form method="post" action="/units/<%= unit.id %>/upgrades/<%= u.key %>" data-confirm="Spend <%= money(u.next.cost) %> of the treasury on <%= u.label %> level <%= u.next.level %>?">
                    <%- csrf %>
                    <button class="btn btn--sm <%= unit.treasury >= u.next.cost ? 'btn--primary' : 'btn--ghost' %>" type="submit" <%- unit.treasury >= u.next.cost ? '' : 'disabled' %>>Upgrade · <%= money(u.next.cost) %></button>
                  </form>
                <% } else { %>
                  <p class="daily__reward">Next level: <%= money(u.next.cost) %></p>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } else { %>
        <section class="card unit-card reveal" style="--i:4" aria-labelledby="upgrades-title">
          <h2 id="upgrades-title" class="card__title">Upgrades</h2>
          <ul class="unit-upgrades unit-upgrades--public">
            <% upgrades.forEach(function (u) { %>
              <li><span class="unit-upgrade__name"><%= u.label %></span> <span class="unit-upgrade__level">Lv <%= u.level %> / <%= u.max %></span> <span class="muted">· <%= u.now %></span></li>
            <% }) %>
          </ul>
        </section>
      <% } %>
      <section class="card unit-card reveal" style="--i:5" aria-labelledby="wars-title">
        <h2 id="wars-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-target"/></svg>War history <a class="card__title-link" href="/wars">All wars</a></h2>
        <% if (warHistory.length) { %>
          <ol class="war-history">
            <% warHistory.forEach(function (w) { %>
              <li class="war-history__row war-history__row--<%= w.outcome %>">
                <span class="war-history__result"><%= w.outcome === 'won' ? 'Won' : w.outcome === 'lost' ? 'Lost' : 'Draw' %></span>
                <a class="war-history__vs" href="/wars/<%= w.id %>">vs [<%= w.them.tag %>] <%= w.them.name %></a>
                <span class="war-history__score"><%= w.ourScore %>–<%= w.theirScore %></span>
                <span class="feed__time"><%= w.ago %></span>
              </li>
            <% }) %>
          </ol>
        <% } else { %>
          <p class="muted">No wars fought yet.</p>
        <% } %>
      </section>
    </div>
  </div>

  <% if (member) { %>
    <div class="unit-grid unit-grid--lower">
      <section id="board" class="card unit-card unit-card--board reveal" style="--i:5" aria-labelledby="board-title">
        <h2 id="board-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-radio"/></svg>Unit board</h2>
        <form method="post" action="/units/<%= unit.id %>/posts" class="unit-post-form">
          <%- csrf %>
          <%- include('partials/bb-editor', { id: 'post-body', name: 'body', label: 'Message to your unit', max: limits.post, rows: 3, placeholder: 'Message your unit…' }) %>
          <button class="btn btn--primary btn--sm" type="submit">Post</button>
        </form>
        <% if (posts.length) { %>
          <ol class="unit-posts">
            <% posts.forEach(function (p) { %>
              <li class="unit-post<%= p.user_id === player.id ? ' is-you' : '' %>">
                <div class="unit-post__head">
                  <%- include('partials/avatar', { url: avatarUrl(p.user_id, p.avatar_v), size: 'xs' }) %>
                  <a class="directory__name" href="/profile/<%= encodeURIComponent(p.username) %>"><strong><%= p.username %></strong></a><% if (!p.still_member) { %> <span class="muted">(left)</span><% } %>
                  <span class="feed__time"><%= p.ago %></span>
                  <button type="button" class="msg__link" data-bb-quote="#post-body" data-author="<%= p.username %>" data-body="<%= p.body %>">Quote</button>
                  <% if (p.canDelete) { %>
                    <form method="post" action="/units/<%= unit.id %>/posts/<%= p.id %>/delete" data-confirm="Delete this post?"><%- csrf %><button class="unit-post__delete" type="submit" aria-label="Delete post">Delete</button></form>
                  <% } %>
                </div>
                <div class="unit-post__body bb-content"><%- p.html %></div>
              </li>
            <% }) %>
          </ol>
        <% } else { %>
          <p class="muted">Nothing posted yet. Say hello to your unit.</p>
        <% } %>
      </section>

      <section class="card unit-card unit-card--log reveal" style="--i:6" aria-labelledby="ulog-title">
        <h2 id="ulog-title" class="card__title">Unit log</h2>
        <ol class="dossier__log">
          <% log.forEach(function (l) { %>
            <li class="log log--unit"><span class="log__time"><%= l.ago %></span> <%= l.message %></li>
          <% }) %>
        </ol>
      </section>
    </div>
  <% } %>

  <% if (can.manage) { %>
    <section id="command" class="card unit-card unit-command reveal" style="--i:7" aria-labelledby="command-title">
      <h2 id="command-title" class="card__title"><svg class="inline-icon" aria-hidden="true"><use href="#i-chevrons"/></svg>Command</h2>
      <div class="unit-command__grid">
        <form method="post" action="/units/<%= unit.id %>/settings" class="form unit-command__form">
          <%- csrf %>
          <div class="field">
            <label for="settings-desc">Description</label>
            <%- include('partials/bb-editor', { id: 'settings-desc', name: 'description', label: 'Unit description', value: unit.description, max: limits.description, rows: 5, required: false, compact: true, placeholder: 'Tell soldiers what your unit is about.' }) %>
          </div>
          <div class="check">
            <input id="settings-recruiting" type="checkbox" name="recruiting" <%- unit.recruiting ? 'checked' : '' %>>
            <label for="settings-recruiting">Accept applications <span class="muted">(untick to close applications)</span></label>
          </div>
          <fieldset class="req-fields">
            <legend>Requirements to apply <span class="muted">(leave blank for none)</span></legend>
            <% requirementFields.forEach(function (f) { %>
              <div class="field">
                <label for="req-<%= f.key %>">Min. <%= f.label.toLowerCase() %></label>
                <input id="req-<%= f.key %>" name="<%= f.key %>" type="number" min="0" max="<%= f.max %>" inputmode="numeric" value="<%= f.value %>" placeholder="Any">
              </div>
            <% }) %>
          </fieldset>
          <button class="btn btn--ghost" type="submit">Save settings</button>
        </form>

        <div class="unit-command__danger">
          <% if (others.length) { %>
            <form method="post" class="form unit-command__form" action="/units/<%= unit.id %>/transfer">
              <%- csrf %>
              <div class="field">
                <label for="transfer-to">Hand over command</label>
                <select id="transfer-to" name="to" class="unit-select">
                  <% others.forEach(function (m) { %><option value="<%= m.id %>"><%= m.username %> (<%= m.roleLabel %>)</option><% }) %>
                </select>
              </div>
              <div class="field">
                <label for="transfer-confirm">Type their callsign to confirm</label>
                <input id="transfer-confirm" name="confirm" autocomplete="off" required>
                <span class="field__hint">You’ll become an officer.</span>
              </div>
              <button class="btn btn--ghost" type="submit">Hand over command</button>
            </form>
          <% } %>
          <form method="post" action="/units/<%= unit.id %>/disband" class="form unit-command__form">
            <%- csrf %>
            <div class="field">
              <label for="disband-confirm">Disband the unit</label>
              <input id="disband-confirm" name="confirm" autocomplete="off" required placeholder="Type <%= unit.tag %> to confirm">
              <span class="field__hint">Everyone is released and the treasury (<%= money(unit.treasury) %>) is lost. This can’t be undone.</span>
            </div>
            <button class="btn btn--ghost btn--danger" type="submit">Disband</button>
          </form>
        </div>
      </div>
    </section>
  <% } %>

  <% if (isAdmin) { %>
    <section class="card unit-card admin-box reveal" style="--i:8" aria-labelledby="admin-unit-title">
      <h2 id="admin-unit-title" class="card__title">Admin</h2>
      <div class="unit-command__grid">
        <form method="post" action="/units/<%= unit.id %>/admin/rename" class="form unit-command__form">
          <%- csrf %>
          <div class="field-row">
            <div class="field"><label for="admin-name">Name</label><input id="admin-name" name="name" value="<%= unit.name %>" required maxlength="24"></div>
            <div class="field"><label for="admin-tag">Tag</label><input id="admin-tag" name="tag" value="<%= unit.tag %>" required maxlength="4"></div>
          </div>
          <button class="btn btn--ghost" type="submit">Rename</button>
        </form>
        <form method="post" action="/units/<%= unit.id %>/admin/disband" class="form unit-command__form" data-confirm="Disband <%= unit.name %> for every member?">
          <%- csrf %>
          <div class="field"><label for="admin-reason">Reason (sent to members)</label><input id="admin-reason" name="reason" maxlength="200"></div>
          <button class="btn btn--ghost btn--danger" type="submit">Disband unit</button>
        </form>
      </div>
    </section>
  <% } %>
</main>

<%- include('partials/foot') %>
