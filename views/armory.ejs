<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>
<% const icons = { weapon: 'i-weapon', body: 'i-body', helmet: 'i-helmet', kit: 'i-kit' }; %>

<main id="main" class="container game-main">
  <%- include('partials/armory-subnav', { shops, active }) %>
  <div class="page-head reveal" style="--i:0">
    <div>
      <p class="eyebrow">Quartermaster</p>
      <h1 class="page-head__title">Armory</h1>
      <p class="page-head__sub">Your loadout and everything you own. Gear raises your combat rating, which improves mission success by up to 15%, and decides PvP fights. Buy more in the shops above.</p>
    </div>
  </div>

  <section class="card armory-summary reveal" style="--i:1" aria-labelledby="loadout-title">
    <h2 id="loadout-title" class="card__title">Your loadout</h2>
    <%- include('partials/loadout', { loadout, editable: true }) %>
    <% if (stimLoaded) { %><p class="supply-item__state">Stim ready. It kicks in on your next attack.</p><% } %>
    <details class="formula">
      <summary>How damage is calculated</summary>
      <div class="formula__body">
        <p>Every bonus is a modifier on a stat, and they combine in three ways:</p>
        <ul>
          <li><strong>Flat</strong> (+10 attack) adds to the base value.</li>
          <li><strong>Increased</strong> (+10% damage) is added together with other increased bonuses, then applied once.</li>
          <li><strong>More</strong> (×1.10 damage) multiplies separately, so these compound. They're rare.</li>
        </ul>
        <p class="formula__eq">Hit = attack × damage × crit (if it lands) × (1 − target's armour reduction)</p>
        <p>Armour reduction is armour ÷ (armour + 100), capped at 75%.</p>
      </div>
    </details>
  </section>

  <section class="reveal" style="--i:2" aria-labelledby="inventory-title">
    <h2 id="inventory-title" class="section-title">Inventory</h2>
    <div class="inventory">
      <% inventory.forEach(function (slot) { %>
        <section class="card inventory__slot" id="inv-<%= slot.id %>" aria-labelledby="inv-<%= slot.id %>-title">
          <h3 id="inv-<%= slot.id %>-title" class="inventory__title"><svg aria-hidden="true"><use href="#<%= icons[slot.id] %>"/></svg><%= slot.label %> <span class="muted small"><%= slot.items.length %></span></h3>
          <% if (slot.items.length) { %>
            <ul class="inventory__list">
              <% slot.items.forEach(function (item) { %>
                <li class="inventory__item<%= item.equipped ? ' is-equipped' : '' %>">
                  <span class="inventory__body">
                    <span class="inventory__name"><%= item.name %></span>
                    <span class="inventory__mods"><%= item.modText.join(' · ') %></span>
                  </span>
                  <% if (item.equipped) { %>
                    <form method="post" action="/armory/unequip/<%= slot.id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--ghost btn--sm" type="submit" aria-label="Stow <%= item.name %>">Stow</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/armory/equip/<%= item.id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--primary btn--sm" type="submit" aria-label="Equip <%= item.name %>">Equip</button>
                    </form>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="muted small inventory__empty">Nothing yet. <a href="/armory/shop/<%= slot.shop.id %>">Visit the <%= slot.shop.name.toLowerCase() %> shop</a>.</p>
          <% } %>
        </section>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/foot') %>
