<%- include('partials/head', { bodyClass: 'page-game' }) %>
<%- include('partials/header') %>

<main id="main" class="container game-main">
  <%- include('partials/armory-subnav', { shops, active }) %>
  <div class="page-head reveal" style="--i:0">
    <div>
      <p class="eyebrow">Armory shop</p>
      <h1 class="page-head__title"><svg class="page-head__icon" aria-hidden="true"><use href="#<%= shop.icon %>"/></svg><%= shop.name %></h1>
      <p class="page-head__sub"><%= shop.blurb %> <%= shop.slot ? 'Gear you buy is equipped straight away and stays in your inventory.' : 'Limits stop money buying unlimited advantage.' %></p>
    </div>
  </div>

  <p class="shop-status muted small reveal" style="--i:1">
    <span>Cash on hand: <strong>$<%= cash.toLocaleString('en-US') %></strong></span>
    <% if (shop.slot) { %><span>Equipped: <strong><%= equipped ? equipped.name : 'nothing' %></strong> · <a href="/armory#inv-<%= shop.slot %>">Inventory</a></span><% } %>
  </p>

  <% if (shop.slot) { %>
    <ul class="item-grid reveal" style="--i:2">
      <% items.forEach(function (item) { %>
        <li class="card item item--<%= item.state %>" id="item-<%= item.id %>">
          <div class="mission__head">
            <span class="mission__theatre"><%= shop.name %></span>
            <span class="mission__level">Lv <%= item.minLevel %>+</span>
          </div>
          <h2 class="item__name"><%= item.name %></h2>
          <p class="item__blurb"><%= item.blurb %></p>
          <ul class="item__mods">
            <% item.modText.forEach(function (t) { %><li><%= t %></li><% }) %>
          </ul>
          <div class="item__foot">
            <span class="item__price"><%= item.state === 'equipped' || item.state === 'owned' ? 'Owned' : '$' + item.price.toLocaleString('en-US') %></span>
            <% if (item.state === 'equipped') { %>
              <span class="item__status"><span class="status-dot" aria-hidden="true"></span>Equipped</span>
            <% } else if (item.state === 'owned') { %>
              <form method="post" action="/armory/equip/<%= item.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--ghost btn--sm" type="submit">Equip</button>
              </form>
            <% } else if (item.state === 'locked') { %>
              <span class="item__status item__status--muted"><svg aria-hidden="true"><use href="#i-lock"/></svg>Level <%= item.minLevel %></span>
            <% } else { %>
              <form method="post" action="/armory/buy/<%= item.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--primary btn--sm" type="submit" <%- item.state === 'expensive' ? 'disabled' : '' %>><%= item.state === 'expensive' ? 'Need funds' : 'Buy' %></button>
              </form>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <ul class="supply-grid reveal" style="--i:2">
      <% supplies.forEach(function (s) { %>
        <li class="card supply-item<%= s.locked ? ' is-locked' : '' %><%= s.loaded ? ' is-loaded' : '' %>" id="supply-<%= s.id %>">
          <div class="supply-item__head">
            <h2 class="supply-item__name"><%= s.name %></h2>
            <span class="supply-item__price">$<%= s.price.toLocaleString('en-US') %></span>
          </div>
          <p class="supply-item__blurb"><%= s.blurb %></p>
          <% if (s.loaded) { %><p class="supply-item__state">Stim ready. It kicks in on your next attack.</p><% } %>
          <form method="post" action="/armory/supplies/<%= s.id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (s.locked) { %>
              <button class="btn btn--locked btn--sm" type="button" disabled><svg class="btn__icon" aria-hidden="true"><use href="#i-lock"/></svg>Level <%= s.minLevel %></button>
            <% } else { %>
              <button class="btn btn--primary btn--sm" type="submit" <%- s.blocker ? 'disabled' : '' %>>Buy &amp; use</button>
              <% if (s.blocker) { %><span class="supply-item__why"><%= s.blocker %></span><% } %>
            <% } %>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<%- include('partials/foot') %>
